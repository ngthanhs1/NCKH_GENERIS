{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 L\u7900 ?I M\u7902 ? \u272 ?\u7846 ?U\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong th\u7901 ?i \u273 ?\u7841 ?i s\u7889 ? h\u243 ?a, d\u7919 ? li\u7879 ?u ng\u224 ?y c\u224 ?ng c\u243 ? t\u237 ?nh {\b li\u234 ?n k\u7871 ?t} (relationship) cao: h\u224 ?nh vi ng\u432 ?\u7901 ?i d\u249 ?ng, t\u432 ?\u417 ?ng t\u225 ?c h\u7879 ? th\u7889 ?ng, lu\u7891 ?ng truy c\u7853 ?p, chu\u7895 ?i s\u7921 ? ki\u7879 ?n\u8230 ? th\u432 ?\u7901 ?ng t\u7841 ?o th\u224 ?nh m\u7897 ?t m\u7841 ?ng l\u432 ?\u7899 ?i quan h\u7879 ? ph\u7913 ?c t\u7841 ?p. V\u7899 ?i c\u225 ?c h\u7879 ? qu\u7843 ?n tr\u7883 ? c\u417 ? s\u7903 ? d\u7919 ? li\u7879 ?u quan h\u7879 ? (RDBMS), vi\u7879 ?c truy v\u7845 ?n theo quan h\u7879 ? nhi\u7873 ?u b\u432 ?\u7899 ?c (multi-hop) th\u432 ?\u7901 ?ng ph\u7843 ?i d\u7921 ?a v\u224 ?o nhi\u7873 ?u ph\u233 ?p n\u7889 ?i (JOIN) v\u224 ? b\u7843 ?ng trung gian, khi\u7871 ?n c\u226 ?u truy v\u7845 ?n d\u224 ?i, kh\u243 ? b\u7843 ?o tr\u236 ?, \u273 ?\u7891 ?ng th\u7901 ?i chi ph\u237 ? x\u7917 ? l\u253 ? c\u243 ? th\u7875 ? t\u259 ?ng m\u7841 ?nh khi s\u7889 ? b\u432 ?\u7899 ?c li\u234 ?n k\u7871 ?t t\u259 ?ng.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Nh\u7853 ?n th\u7845 ?y \u273 ?\u7863 ?c th\u249 ? c\u7911 ?a c\u225 ?c b\u224 ?i to\u225 ?n nh\u432 ? ph\u225 ?t hi\u7879 ?n gian l\u7853 ?n/phishing l\u224 ? \u8220"quan h\u7879 ? l\u224 ? trung t\u226 ?m\u8221", nh\u243 ?m ch\u250 ?ng em l\u7921 ?a ch\u7885 ?n ti\u7871 ?p c\u7853 ?n b\u7857 ?ng {\b c\u417 ? s\u7903 ? d\u7919 ? li\u7879 ?u \u273 ?\u7891 ? th\u7883 ? (Graph Database)}. Trong \u273 ?\u7891 ? \u225 ?n n\u224 ?y, nh\u243 ?m x\u226 ?y d\u7921 ?ng m\u7897 ?t h\u7879 ? th\u7889 ?ng minh h\u7885 ?a d\u7921 ?a tr\u234 ?n Neo4j, m\u244 ? h\u236 ?nh h\u243 ?a chu\u7895 ?i li\u234 ?n k\u7871 ?t {\b Email \u8211- URL \u8211- IPAddress}, v\u224 ? tri\u7875 ?n khai m\u7897 ?t pipeline demo end-to-end. Tr\u234 ?n n\u7873 ?n \u273 ?\u7891 ? th\u7883 ? \u273 ?\u243 ?, h\u7879 ? th\u7889 ?ng th\u7921 ?c hi\u7879 ?n:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ingest d\u7919 ? li\u7879 ?u (t\u7841 ?o node/relationship) theo c\u225 ?c k\u7883 ?ch b\u7843 ?n demo.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ph\u226 ?n t\u237 ?ch r\u7911 ?i ro theo lu\u7853 ?t (rule-based) \u273 ?\u7875 ? g\u225 ?n \u273 ?i\u7875 ?m {\f1 riskScore} v\u224 ? nh\u227 ?n {\f1 verdict}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Tr\u7921 ?c quan h\u243 ?a \u273 ?\u7891 ? th\u7883 ? b\u7857 ?ng D3.js \u273 ?\u7875 ? ng\u432 ?\u7901 ?i d\u249 ?ng quan s\u225 ?t, l\u7885 ?c v\u224 ? xem chi ti\u7871 ?t.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?i\u7875 ?m nh\u7845 ?n c\u7911 ?a \u273 ?\u7891 ? \u225 ?n l\u224 ? c\u417 ? ch\u7871 ? {\b triad-gating} (k\u7871 ?t lu\u7853 ?n th\u7853 ?n tr\u7885 ?ng): ch\u7881 ? khi m\u7897 ?t th\u7921 ?c th\u7875 ? tham gia \u273 ?\u7911 ? tam gi\u225 ?c Email\u8211-URL\u8211-IP th\u236 ? m\u7899 ?i k\u7871 ?t lu\u7853 ?n r\u245 ? r\u224 ?ng; n\u7871 ?u thi\u7871 ?u ng\u7919 ? c\u7843 ?nh th\u236 ? tr\u7843 ? {\f1 UNKNOWN} \u273 ?\u7875 ? tr\u225 ?nh suy di\u7877 ?n t\u7915 ? d\u7919 ? li\u7879 ?u r\u7901 ?i r\u7841 ?c.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7909 ?c ti\u234 ?u c\u7911 ?a \u273 ?\u7891 ? \u225 ?n:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab T\u236 ?m hi\u7875 ?u c\u417 ? s\u7903 ? l\u253 ? thuy\u7871 ?t v\u7873 ? \u273 ?\u7891 ? th\u7883 ?, Graph Database v\u224 ? Neo4j/Cypher.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab X\u226 ?y d\u7921 ?ng m\u244 ? h\u236 ?nh d\u7919 ? li\u7879 ?u \u273 ?\u7891 ? th\u7883 ? ph\u249 ? h\u7907 ?p cho b\u224 ?i to\u225 ?n minh h\u7885 ?a (Email\u8211-URL\u8211-IP).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab Minh h\u7885 ?a truy v\u7845 ?n theo pattern (shared URL/shared IP/triad) v\u224 ? gi\u7843 ?i th\u237 ?ch \u8220"v\u236 ? sao \u273 ?\u225 ?ng nghi\u8221" d\u7921 ?a tr\u234 ?n c\u7845 ?u tr\u250 ?c li\u234 ?n k\u7871 ?t.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 4)\tx360\tab Hi\u7879 ?n th\u7921 ?c h\u243 ?a \u7913 ?ng d\u7909 ?ng demo end-to-end (backend API + giao di\u7879 ?n tr\u7921 ?c quan).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ph\u7841 ?m vi v\u224 ? gi\u7843 ? \u273 ?\u7883 ?nh:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab H\u7879 ? th\u7889 ?ng l\u224 ? {\b demo h\u7885 ?c t\u7853 ?p}, t\u7853 ?p trung v\u224 ?o m\u244 ? h\u236 ?nh h\u243 ?a v\u224 ? truy v\u7845 ?n pattern tr\u234 ?n \u273 ?\u7891 ? th\u7883 ?; kh\u244 ?ng nh\u7857 ?m thay th\u7871 ? h\u7879 ? th\u7889 ?ng ph\u225 ?t hi\u7879 ?n gian l\u7853 ?n th\u7921 ?c t\u7871 ?.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Thu\u7853 ?t to\u225 ?n ch\u7845 ?m \u273 ?i\u7875 ?m d\u7841 ?ng rule-based \u273 ?\u432 ?\u7907 ?c thi\u7871 ?t k\u7871 ? \u273 ?\u7875 ? tr\u7921 ?c quan h\u243 ?a v\u224 ? minh h\u7885 ?a (kh\u244 ?ng ph\u7843 ?i ML).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u272 ?\u7875 ? tr\u225 ?nh k\u7871 ?t lu\u7853 ?n khi thi\u7871 ?u ng\u7919 ? c\u7843 ?nh, h\u7879 ? th\u7889 ?ng \u225 ?p d\u7909 ?ng nguy\u234 ?n t\u7855 ?c {\b triad-gating}: n\u7871 ?u m\u7897 ?t Email/URL/IP ch\u432 ?a tham gia \u273 ?\u7911 ? tam gi\u225 ?c Email\u8211-URL\u8211-IP th\u236 ? g\u225 ?n {\f1 verdict=UNKNOWN} v\u224 ? {\f1 riskScore=0} trong API ph\u226 ?n t\u237 ?ch t\u7893 ?ng quan.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Trong b\u225 ?o c\u225 ?o, c\u7847 ?n ph\u226 ?n bi\u7879 ?t: {\f1 riskScore} {\b l\u432 ?u tr\u234 ?n node} (\u273 ?\u432 ?\u7907 ?c c\u7853 ?p nh\u7853 ?t b\u7903 ?i {\f1 /api/graph/analyze}, thang 0\u8211-100) v\u224 ? {\f1 riskScore} {\b trong nh\u243 ?m {\f1 /api/graph/analysis/*}} (\u273 ?i\u7875 ?m th\u7889 ?ng k\u234 ? theo s\u7889 ? li\u234 ?n k\u7871 ?t, ph\u7909 ?c v\u7909 ? gi\u7843 ?i th\u237 ?ch/di\u7877 ?n gi\u7843 ?i).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 B\u7889 ? c\u7909 ?c b\u225 ?o c\u225 ?o g\u7891 ?m 7 ch\u432 ?\u417 ?ng theo y\u234 ?u c\u7847 ?u: (1) C\u417 ? s\u7903 ? l\u253 ? thuy\u7871 ?t, (2) Ph\u226 ?n t\u237 ?ch b\u224 ?i to\u225 ?n minh h\u7885 ?a, (3) Ph\u226 ?n t\u237 ?ch h\u7879 ? th\u7889 ?ng, (4) Thi\u7871 ?t k\u7871 ? h\u7879 ? th\u7889 ?ng, (5) X\u226 ?y d\u7921 ?ng v\u224 ? c\u224 ?i \u273 ?\u7863 ?t, (6) Ph\u226 ?n t\u237 ?ch v\u224 ? \u273 ?\u225 ?nh gi\u225 ?, (7) Th\u7921 ?c nghi\u7879 ?m h\u7879 ? th\u7889 ?ng. Ph\u7847 ?n k\u7871 ?t lu\u7853 ?n t\u7893 ?ng h\u7907 ?p k\u7871 ?t qu\u7843 ? \u273 ?\u7841 ?t \u273 ?\u432 ?\u7907 ?c v\u224 ? h\u432 ?\u7899 ?ng ph\u225 ?t tri\u7875 ?n.\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 CH\u431 ?\u416 ?NG 1: C\u416 ? S\u7902 ? L\u221 ? THUY\u7870 ?T\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 1.1 L\u253 ? thuy\u7871 ?t \u273 ?\u7891 ? th\u7883 ? (Graph Theory)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.1 Kh\u225 ?i ni\u7879 ?m \u273 ?\u7891 ? th\u7883 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong to\u225 ?n h\u7885 ?c v\u224 ? khoa h\u7885 ?c m\u225 ?y t\u237 ?nh, {\b \u273 ?\u7891 ? th\u7883 ? (Graph)} l\u224 ? c\u7845 ?u tr\u250 ?c d\u249 ?ng \u273 ?\u7875 ? m\u244 ? h\u236 ?nh h\u243 ?a c\u225 ?c \u273 ?\u7889 ?i t\u432 ?\u7907 ?ng v\u224 ? m\u7889 ?i quan h\u7879 ? gi\u7919 ?a ch\u250 ?ng. \u272 ?\u7891 ? th\u7883 ? xu\u7845 ?t hi\u7879 ?n trong nhi\u7873 ?u l\u297 ?nh v\u7921 ?c: m\u7841 ?ng m\u225 ?y t\u237 ?nh (k\u7871 ?t n\u7889 ?i thi\u7871 ?t b\u7883 ?), m\u7841 ?ng x\u227 ? h\u7897 ?i (quan h\u7879 ? b\u7841 ?n b\u232 ?), b\u224 ?i to\u225 ?n t\u236 ?m \u273 ?\u432 ?\u7901 ?ng (Dijkstra), v\u224 ? trong c\u417 ? s\u7903 ? d\u7919 ? li\u7879 ?u (bi\u7875 ?u di\u7877 ?n d\u7919 ? li\u7879 ?u li\u234 ?n k\u7871 ?t).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong ng\u7919 ? c\u7843 ?nh c\u417 ? s\u7903 ? d\u7919 ? li\u7879 ?u, c\u243 ? th\u7875 ? hi\u7875 ?u tr\u7921 ?c quan:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Node} t\u432 ?\u417 ?ng \u7913 ?ng v\u7899 ?i \u8220"th\u7921 ?c th\u7875 ?\u8221" (entity) c\u7847 ?n l\u432 ?u.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Edge/Relationship} t\u432 ?\u417 ?ng \u7913 ?ng v\u7899 ?i \u8220"m\u7889 ?i quan h\u7879 ?\u8221" (relationship) gi\u7919 ?a c\u225 ?c th\u7921 ?c th\u7875 ?.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Truy v\u7845 ?n th\u432 ?\u7901 ?ng l\u224 ? \u8220"t\u236 ?m pattern\u8221" ho\u7863 ?c \u8220"truy v\u7871 ?t \u273 ?\u432 ?\u7901 ?ng \u273 ?i\u8221" thay v\u236 ? ch\u7881 ? l\u7885 ?c theo thu\u7897 ?c t\u237 ?nh.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7897 ?t \u273 ?\u7891 ? th\u7883 ? th\u432 ?\u7901 ?ng \u273 ?\u432 ?\u7907 ?c bi\u7875 ?u di\u7877 ?n d\u432 ?\u7899 ?i d\u7841 ?ng:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\i G}\u8196 ?=\u8196 ?({\i V},{\i E})\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong \u273 ?\u243 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\i V} (Vertices/Nodes): t\u7853 ?p c\u225 ?c {\b \u273 ?\u7881 ?nh}, \u273 ?\u7841 ?i di\u7879 ?n cho c\u225 ?c th\u7921 ?c th\u7875 ?/\u273 ?\u7889 ?i t\u432 ?\u7907 ?ng.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\i E} (Edges): t\u7853 ?p c\u225 ?c {\b c\u7841 ?nh}, bi\u7875 ?u di\u7877 ?n quan h\u7879 ? gi\u7919 ?a c\u225 ?c \u273 ?\u7881 ?nh.\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 {\b H\u236 ?nh 1.1 (minh h\u7885 ?a)}: V\u237 ? d\u7909 ? m\u7897 ?t \u273 ?\u7891 ? th\u7883 ? \u273 ?\u417 ?n gi\u7843 ?n g\u7891 ?m 5 \u273 ?\u7881 ?nh v\u224 ? c\u225 ?c c\u7841 ?nh n\u7889 ?i gi\u7919 ?a c\u225 ?c \u273 ?\u7881 ?nh (ch\u232 ?n h\u236 ?nh t\u7921 ? v\u7869 ? ho\u7863 ?c h\u236 ?nh minh h\u7885 ?a).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.2 \u272 ?\u7881 ?nh (Node) v\u224 ? C\u7841 ?nh (Edge)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b \u272 ?\u7881 ?nh (Node/Vertex)}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u272 ?\u7841 ?i di\u7879 ?n cho m\u7897 ?t th\u7921 ?c th\u7875 ? \u273 ?\u7897 ?c l\u7853 ?p trong h\u7879 ? th\u7889 ?ng.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u243 ? th\u7875 ? mang thu\u7897 ?c t\u237 ?nh (v\u237 ? d\u7909 ?: ID, t\u234 ?n, lo\u7841 ?i...).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab L\u224 ? \u273 ?\u417 ?n v\u7883 ? c\u417 ? b\u7843 ?n c\u7911 ?a \u273 ?\u7891 ? th\u7883 ?.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b C\u7841 ?nh (Edge)}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Bi\u7875 ?u di\u7877 ?n m\u7889 ?i quan h\u7879 ? gi\u7919 ?a hai \u273 ?\u7881 ?nh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Quan h\u7879 ? c\u243 ? th\u7875 ? mang \u253 ? ngh\u297 ?a logic/v\u7853 ?t l\u253 ?/ng\u7919 ? ngh\u297 ?a.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u249 ?y m\u244 ? h\u236 ?nh, c\u7841 ?nh c\u243 ? th\u7875 ? c\u243 ? tr\u7885 ?ng s\u7889 ? ho\u7863 ?c thu\u7897 ?c t\u237 ?nh b\u7893 ? sung.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.3 \u272 ?\u7891 ? th\u7883 ? c\u243 ? h\u432 ?\u7899 ?ng v\u224 ? v\u244 ? h\u432 ?\u7899 ?ng\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b \u272 ?\u7891 ? th\u7883 ? c\u243 ? h\u432 ?\u7899 ?ng (Directed Graph)}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u7841 ?nh c\u243 ? chi\u7873 ?u t\u7915 ? \u273 ?\u7881 ?nh ngu\u7891 ?n \u273 ?\u7871 ?n \u273 ?\u7881 ?nh \u273 ?\u237 ?ch.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab V\u237 ? d\u7909 ?: li\u234 ?n k\u7871 ?t gi\u7919 ?a c\u225 ?c trang web (A tr\u7887 ? \u273 ?\u7871 ?n B).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b \u272 ?\u7891 ? th\u7883 ? v\u244 ? h\u432 ?\u7899 ?ng (Undirected Graph)}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u7841 ?nh kh\u244 ?ng c\u243 ? chi\u7873 ?u, bi\u7875 ?u di\u7877 ?n quan h\u7879 ? \u273 ?\u7889 ?i x\u7913 ?ng.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab V\u237 ? d\u7909 ?: quan h\u7879 ? b\u7841 ?n b\u232 ? (A l\u224 ? b\u7841 ?n B v\u224 ? B l\u224 ? b\u7841 ?n A).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong Neo4j, relationship th\u432 ?\u7901 ?ng l\u224 ? {\b c\u243 ? h\u432 ?\u7899 ?ng}, \u273 ?i\u7873 ?u n\u224 ?y gi\u250 ?p m\u244 ? h\u236 ?nh h\u243 ?a lu\u7891 ?ng/quan h\u7879 ? r\u245 ? r\u224 ?ng (v\u237 ? d\u7909 ? Email {\b CONTAINS_LINK} t\u7899 ?i URL).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.4 \u272 ?\u7891 ? th\u7883 ? c\u243 ? tr\u7885 ?ng s\u7889 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong \u273 ?\u7891 ? th\u7883 ? c\u243 ? tr\u7885 ?ng s\u7889 ?, m\u7895 ?i c\u7841 ?nh \u273 ?\u432 ?\u7907 ?c g\u225 ?n m\u7897 ?t gi\u225 ? tr\u7883 ? s\u7889 ? (tr\u7885 ?ng s\u7889 ?) \u273 ?\u7841 ?i di\u7879 ?n cho chi ph\u237 ?, kho\u7843 ?ng c\u225 ?ch ho\u7863 ?c c\u432 ?\u7901 ?ng \u273 ?\u7897 ? li\u234 ?n k\u7871 ?t. Tr\u7885 ?ng s\u7889 ? \u273 ?\u432 ?\u7907 ?c d\u249 ?ng trong c\u225 ?c b\u224 ?i to\u225 ?n t\u7889 ?i \u432 ?u nh\u432 ? t\u236 ?m \u273 ?\u432 ?\u7901 ?ng \u273 ?i ng\u7855 ?n.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong \u273 ?\u7891 ? \u225 ?n n\u224 ?y, m\u244 ? h\u236 ?nh minh h\u7885 ?a t\u7853 ?p trung v\u224 ?o {\b structure/pattern} h\u417 ?n l\u224 ? t\u7889 ?i \u432 ?u \u273 ?\u432 ?\u7901 ?ng \u273 ?i theo tr\u7885 ?ng s\u7889 ?, n\u234 ?n kh\u244 ?ng tri\u7875 ?n khai tr\u7885 ?ng s\u7889 ?.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.5 Bi\u7875 ?u di\u7877 ?n \u273 ?\u7891 ? th\u7883 ? trong m\u225 ?y t\u237 ?nh\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Khi hi\u7879 ?n th\u7921 ?c h\u243 ?a \u273 ?\u7891 ? th\u7883 ? trong ch\u432 ?\u417 ?ng tr\u236 ?nh, c\u243 ? hai c\u225 ?ch bi\u7875 ?u di\u7877 ?n ph\u7893 ? bi\u7871 ?n:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b Ma tr\u7853 ?n k\u7873 ? (Adjacency Matrix)}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u249 ?ng m\u7897 ?t ma tr\u7853 ?n |{\i V}|\u8197 ?\u215 ?\u8197 ?|{\i V}|.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ph\u249 ? h\u7907 ?p khi \u273 ?\u7891 ? th\u7883 ? d\u224 ?y \u273 ?\u7863 ?c (nhi\u7873 ?u c\u7841 ?nh).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u7889 ?n b\u7897 ? nh\u7899 ? {\i O}(|{\i V}|{\super 2}).\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b Danh s\u225 ?ch k\u7873 ? (Adjacency List)}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab V\u7899 ?i m\u7895 ?i \u273 ?\u7881 ?nh, l\u432 ?u danh s\u225 ?ch c\u225 ?c \u273 ?\u7881 ?nh k\u7873 ? (ho\u7863 ?c c\u225 ?c c\u7841 ?nh k\u7873 ?).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ph\u249 ? h\u7907 ?p khi \u273 ?\u7891 ? th\u7883 ? th\u432 ?a (sparse), ph\u7893 ? bi\u7871 ?n trong th\u7921 ?c t\u7871 ?.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u7889 ?n b\u7897 ? nh\u7899 ? x\u7845 ?p x\u7881 ? {\i O}(|{\i V}|+|{\i E}|).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong Graph Database, quan h\u7879 ? \u273 ?\u432 ?\u7907 ?c l\u432 ?u tr\u7919 ? nh\u432 ? \u8220"c\u7841 ?nh\u8221" c\u243 ? th\u7875 ? duy\u7879 ?t tr\u7921 ?c ti\u7871 ?p; do \u273 ?\u243 ? c\u225 ?c truy v\u7845 ?n d\u7841 ?ng truy v\u7871 ?t nhi\u7873 ?u b\u432 ?\u7899 ?c (multi-hop) th\u432 ?\u7901 ?ng \u273 ?\u432 ?\u7907 ?c t\u7889 ?i \u432 ?u t\u7889 ?t.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.6 Duy\u7879 ?t \u273 ?\u7891 ? th\u7883 ? (Traversal) v\u224 ? truy v\u7871 ?t multi-hop\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Traversal} l\u224 ? thao t\u225 ?c \u273 ?i t\u7915 ? m\u7897 ?t node sang c\u225 ?c node l\u226 ?n c\u7853 ?n theo c\u7841 ?nh. \u272 ?\u226 ?y l\u224 ? thao t\u225 ?c n\u7873 ?n t\u7843 ?ng cho nhi\u7873 ?u b\u224 ?i to\u225 ?n:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Truy v\u7871 ?t \u273 ?\u432 ?\u7901 ?ng \u273 ?i (path/trail)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u236 ?m c\u225 ?c node li\u234 ?n quan trong N b\u432 ?\u7899 ?c (k-hop neighborhood)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ph\u225 ?t hi\u7879 ?n c\u225 ?c c\u7909 ?m/chi\u7871 ?n d\u7883 ?ch (campaign/community)\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong \u273 ?\u7891 ? \u225 ?n, c\u225 ?c truy v\u7871 ?t \u273 ?i\u7875 ?n h\u236 ?nh l\u224 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email \u8594 ? URL (email ch\u7913 ?a link)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email \u8594 ? IP (email g\u7917 ?i t\u7915 ? IP)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email \u8594 ? URL \u8594 ? IP (chu\u7895 ?i li\u234 ?n k\u7871 ?t ho\u224 ?n ch\u7881 ?nh, g\u7885 ?i l\u224 ? {\b triad/tam gi\u225 ?c} trong b\u225 ?o c\u225 ?o)\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.7 M\u7897 ?t s\u7889 ? ch\u7881 ? s\u7889 ? \u273 ?\u7891 ? th\u7883 ? c\u417 ? b\u7843 ?n (ph\u7909 ?c v\u7909 ? b\u224 ?i to\u225 ?n gian l\u7853 ?n)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7897 ?t s\u7889 ? ch\u7881 ? s\u7889 ? \u273 ?\u417 ?n gi\u7843 ?n nh\u432 ?ng h\u7919 ?u \u237 ?ch khi ph\u226 ?n t\u237 ?ch gian l\u7853 ?n/phishing:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Degree}: s\u7889 ? c\u7841 ?nh v\u224 ?o/ra c\u7911 ?a node. Node c\u243 ? degree l\u7899 ?n (hub) c\u243 ? th\u7875 ? l\u224 ? IP/URL d\u249 ?ng chung.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Shared pattern}: m\u7897 ?t URL \u273 ?\u432 ?\u7907 ?c nhi\u7873 ?u email tr\u7887 ? t\u7899 ?i (shared URL), m\u7897 ?t IP \u273 ?\u432 ?\u7907 ?c nhi\u7873 ?u email s\u7917 ? d\u7909 ?ng (shared IP).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Subgraph / motif}: m\u7851 ?u con l\u7863 ?p l\u7841 ?i; trong \u273 ?\u7891 ? \u225 ?n l\u224 ? motif tam gi\u225 ?c Email\u8211-URL\u8211-IP.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 C\u225 ?c ch\u7881 ? s\u7889 ? n\u226 ?ng cao (\u273 ?\u7883 ?nh h\u432 ?\u7899 ?ng m\u7903 ? r\u7897 ?ng): PageRank, betweenness/closenness centrality, community detection.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.8 \u272 ?\u432 ?\u7901 ?ng \u273 ?i (Path), chu tr\u236 ?nh (Cycle) v\u224 ? \u253 ? ngh\u297 ?a trong truy v\u7871 ?t\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Walk}: chu\u7895 ?i c\u225 ?c \u273 ?\u7881 ?nh/c\u7841 ?nh li\u234 ?n ti\u7871 ?p (c\u243 ? th\u7875 ? l\u7863 ?p \u273 ?\u7881 ?nh/c\u7841 ?nh).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Trail}: walk kh\u244 ?ng l\u7863 ?p c\u7841 ?nh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Path (\u273 ?\u432 ?\u7901 ?ng \u273 ?i \u273 ?\u417 ?n)}: walk kh\u244 ?ng l\u7863 ?p \u273 ?\u7881 ?nh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Cycle (chu tr\u236 ?nh)}: path b\u7855 ?t \u273 ?\u7847 ?u v\u224 ? k\u7871 ?t th\u250 ?c t\u7841 ?i c\u249 ?ng m\u7897 ?t \u273 ?\u7881 ?nh.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong b\u224 ?i to\u225 ?n gian l\u7853 ?n/phishing, c\u225 ?c truy v\u7845 ?n th\u432 ?\u7901 ?ng c\u243 ? d\u7841 ?ng \u8220"t\u236 ?m path\u8221" ho\u7863 ?c \u8220"t\u236 ?m c\u225 ?c node trong b\u225 ?n k\u237 ?nh k b\u432 ?\u7899 ?c\u8221" \u273 ?\u7875 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Truy v\u7871 ?t ngu\u7891 ?n g\u7889 ?c (Email d\u7851 ?n t\u7899 ?i URL n\u224 ?o, URL host \u7903 ? IP n\u224 ?o).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ph\u225 ?t hi\u7879 ?n c\u7845 ?u tr\u250 ?c l\u7863 ?p (v\u237 ? d\u7909 ? nhi\u7873 ?u Email \u8594 ? c\u249 ?ng URL).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.9 Thu\u7853 ?t to\u225 ?n duy\u7879 ?t c\u417 ? b\u7843 ?n: BFS v\u224 ? DFS\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Hai thu\u7853 ?t to\u225 ?n duy\u7879 ?t \u273 ?\u7891 ? th\u7883 ? ph\u7893 ? bi\u7871 ?n:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b BFS (Breadth-First Search)}: duy\u7879 ?t theo t\u7915 ?ng l\u7899 ?p (level) t\u7915 ? node ngu\u7891 ?n. Ph\u249 ? h\u7907 ?p khi c\u7847 ?n t\u236 ?m c\u225 ?c node trong k b\u432 ?\u7899 ?c ho\u7863 ?c \u273 ?\u432 ?\u7901 ?ng \u273 ?i ng\u7855 ?n nh\u7845 ?t tr\u234 ?n \u273 ?\u7891 ? th\u7883 ? kh\u244 ?ng tr\u7885 ?ng s\u7889 ?.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b DFS (Depth-First Search)}: \u273 ?i s\u226 ?u theo nh\u225 ?nh, ph\u249 ? h\u7907 ?p \u273 ?\u7875 ? t\u236 ?m th\u224 ?nh ph\u7847 ?n li\u234 ?n th\u244 ?ng, ph\u225 ?t hi\u7879 ?n chu tr\u236 ?nh, ho\u7863 ?c li\u7879 ?t k\u234 ? \u273 ?\u432 ?\u7901 ?ng \u273 ?i.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong Graph DB, traversal th\u432 ?\u7901 ?ng \u273 ?\u432 ?\u7907 ?c h\u7879 ? qu\u7843 ?n tr\u7883 ? t\u7889 ?i \u432 ?u n\u7897 ?i b\u7897 ?; ng\u432 ?\u7901 ?i d\u249 ?ng m\u244 ? t\u7843 ? pattern/truy v\u7871 ?t b\u7857 ?ng truy v\u7845 ?n (Cypher) thay v\u236 ? t\u7921 ? hi\u7879 ?n th\u7921 ?c BFS/DFS.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.1.10 \u272 ?\u7897 ? ph\u7913 ?c t\u7841 ?p (mang t\u237 ?nh kh\u225 ?i qu\u225 ?t)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u7899 ?i bi\u7875 ?u di\u7877 ?n danh s\u225 ?ch k\u7873 ?, BFS/DFS c\u243 ? \u273 ?\u7897 ? ph\u7913 ?c t\u7841 ?p th\u7901 ?i gian x\u7845 ?p x\u7881 ?:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\i O}(|{\i V}|+|{\i E}|)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u221 ? ngh\u297 ?a trong th\u7921 ?c t\u7871 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab N\u7871 ?u truy v\u7845 ?n \u8220"qu\u233 ?t\u8221" qu\u225 ? r\u7897 ?ng (v\u237 ? d\u7909 ? kh\u244 ?ng gi\u7899 ?i h\u7841 ?n), traversal c\u243 ? th\u7875 ? n\u7863 ?ng.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Do \u273 ?\u243 ?, khi thi\u7871 ?t k\u7871 ? truy v\u7845 ?n pattern n\u234 ?n gi\u7899 ?i h\u7841 ?n theo lo\u7841 ?i node, h\u432 ?\u7899 ?ng c\u7841 ?nh, ho\u7863 ?c \u273 ?i\u7873 ?u ki\u7879 ?n l\u7885 ?c.\sa180\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 1.2 C\u417 ? s\u7903 ? d\u7919 ? li\u7879 ?u \u273 ?\u7891 ? th\u7883 ? (Graph Database)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.2.1 Kh\u225 ?i ni\u7879 ?m Graph Database\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Graph Database} l\u224 ? h\u7879 ? qu\u7843 ?n tr\u7883 ? c\u417 ? s\u7903 ? d\u7919 ? li\u7879 ?u s\u7917 ? d\u7909 ?ng c\u7845 ?u tr\u250 ?c \u273 ?\u7891 ? th\u7883 ? \u273 ?\u7875 ? l\u432 ?u tr\u7919 ? v\u224 ? bi\u7875 ?u di\u7877 ?n d\u7919 ? li\u7879 ?u. D\u7919 ? li\u7879 ?u \u273 ?\u432 ?\u7907 ?c m\u244 ? h\u236 ?nh h\u243 ?a b\u7903 ?i:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Node}: th\u7921 ?c th\u7875 ?\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Relationship/Edge}: quan h\u7879 ?\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Properties}: thu\u7897 ?c t\u237 ?nh key\u8211-value g\u7855 ?n tr\u234 ?n node/relationship\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Kh\u225 ?c v\u7899 ?i RDBMS, graph database l\u432 ?u tr\u7919 ? quan h\u7879 ? nh\u432 ? m\u7897 ?t c\u7845 ?u tr\u250 ?c li\u234 ?n k\u7871 ?t tr\u7921 ?c ti\u7871 ?p, gi\u250 ?p truy v\u7845 ?n theo quan h\u7879 ? nhi\u7873 ?u b\u432 ?\u7899 ?c tr\u7903 ? n\u234 ?n t\u7921 ? nhi\u234 ?n h\u417 ?n.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.2.2 M\u244 ? h\u236 ?nh Property Graph\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Property Graph} l\u224 ? m\u244 ? h\u236 ?nh ph\u7893 ? bi\u7871 ?n (Neo4j s\u7917 ? d\u7909 ?ng) v\u7899 ?i \u273 ?\u7863 ?c \u273 ?i\u7875 ?m:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Node c\u243 ? {\b label} (v\u237 ? d\u7909 ? {\f1 :Email}, {\f1 :URL}).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Node/relationship c\u243 ? {\b properties} d\u7841 ?ng key\u8211-value.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Relationship c\u243 ? {\b type} (v\u237 ? d\u7909 ? {\f1 CONTAINS_LINK}, {\f1 SENT_FROM}) v\u224 ? {\b h\u432 ?\u7899 ?ng}.\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 {\b H\u236 ?nh 1.2 (minh h\u7885 ?a)}: Property graph v\u7899 ?i c\u225 ?c node Email/URL/IP v\u224 ? c\u225 ?c relationship c\u243 ? h\u432 ?\u7899 ?ng.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.2.3 Node \u8211- Relationship \u8211- Property\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Node}: \u273 ?\u7889 ?i t\u432 ?\u7907 ?ng ch\u237 ?nh, c\u243 ? \u273 ?\u7883 ?nh danh v\u224 ? thu\u7897 ?c t\u237 ?nh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Relationship}: k\u7871 ?t n\u7889 ?i gi\u7919 ?a node, th\u432 ?\u7901 ?ng c\u243 ? h\u432 ?\u7899 ?ng, c\u243 ? type.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Property}: d\u7919 ? li\u7879 ?u b\u7893 ? tr\u7907 ? (string/number/boolean/list...).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.2.4 \u431 ?u \u273 ?i\u7875 ?m c\u7911 ?a Graph Database\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Hi\u7879 ?u qu\u7843 ? cho truy v\u7845 ?n theo quan h\u7879 ? (traversal)}: \u273 ?\u7863 ?c bi\u7879 ?t khi c\u7847 ?n truy v\u7845 ?n multi-hop.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Linh ho\u7841 ?t khi m\u7903 ? r\u7897 ?ng m\u244 ? h\u236 ?nh}: th\u234 ?m node/relationship m\u7899 ?i \u237 ?t \u7843 ?nh h\u432 ?\u7903 ?ng schema.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Tr\u7921 ?c quan h\u243 ?a t\u7889 ?t}: d\u7877 ? minh h\u7885 ?a v\u224 ? gi\u7843 ?i th\u237 ?ch.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 H\u7841 ?n ch\u7871 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Kh\u244 ?ng ph\u7843 ?i l\u250 ?c n\u224 ?o c\u361 ?ng t\u7889 ?i \u432 ?u cho c\u225 ?c truy v\u7845 ?n t\u7893 ?ng h\u7907 ?p thu\u7847 ?n b\u7843 ?ng (aggregate \u273 ?\u417 ?n gi\u7843 ?n) hay c\u225 ?c workload OLTP truy\u7873 ?n th\u7889 ?ng.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u236 ? v\u7853 ?y, c\u225 ?ch ti\u7871 ?p c\u7853 ?n ph\u249 ? h\u7907 ?p trong \u273 ?\u7891 ? \u225 ?n l\u224 ?: d\u249 ?ng Graph DB \u273 ?\u7875 ? minh h\u7885 ?a v\u224 ? khai th\u225 ?c quan h\u7879 ?/pattern; c\u225 ?c th\u7889 ?ng k\u234 ?/report \u7903 ? m\u7913 ?c demo c\u243 ? th\u7875 ? l\u224 ?m tr\u234 ?n d\u7919 ? li\u7879 ?u graph tr\u7843 ? ra t\u7915 ? API.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.2.5 Graph Database v\u224 ? y\u234 ?u c\u7847 ?u b\u224 ?i to\u225 ?n \u8220"quan h\u7879 ? l\u224 ? trung t\u226 ?m\u8221"\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?\u7889 ?i v\u7899 ?i b\u224 ?i to\u225 ?n gian l\u7853 ?n/phishing, gi\u225 ? tr\u7883 ? th\u432 ?\u7901 ?ng kh\u244 ?ng n\u7857 ?m \u7903 ? thu\u7897 ?c t\u237 ?nh \u273 ?\u417 ?n l\u7867 ? c\u7911 ?a m\u7897 ?t th\u7921 ?c th\u7875 ? (m\u7897 ?t email \u8220"l\u7841 ?\u8221"), m\u224 ? n\u7857 ?m \u7903 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Th\u7921 ?c th\u7875 ? \u273 ?\u243 ? li\u234 ?n k\u7871 ?t t\u7899 ?i ai/c\u225 ?i g\u236 ?.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u7847 ?n su\u7845 ?t d\u249 ?ng chung c\u7911 ?a h\u7841 ? t\u7847 ?ng (shared IP/shared URL).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u7845 ?u tr\u250 ?c l\u7863 ?p l\u7841 ?i theo chi\u7871 ?n d\u7883 ?ch.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Do \u273 ?\u243 ?, Graph Database ph\u249 ? h\u7907 ?p \u273 ?\u7875 ? m\u244 ? h\u236 ?nh h\u243 ?a v\u224 ? truy v\u7845 ?n d\u7841 ?ng \u8220"pattern query\u8221", \u8220"truy v\u7871 ?t\u8221" v\u224 ? \u8220"ph\u226 ?n c\u7909 ?m\u8221".\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.2.6 R\u224 ?ng bu\u7897 ?c (Constraints) v\u224 ? ch\u7881 ? m\u7909 ?c (Index) trong Graph DB\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong h\u7879 ? th\u7889 ?ng demo, nh\u243 ?m chu\u7849 ?n h\u243 ?a \u273 ?\u7883 ?nh danh node b\u7857 ?ng property {\f1 id} (v\u237 ? d\u7909 ? {\f1 Email:<value>}). V\u7899 ?i c\u225 ?c h\u7879 ? th\u7889 ?ng th\u7921 ?c t\u7871 ?, n\u234 ?n t\u259 ?ng t\u237 ?nh nh\u7845 ?t qu\u225 ?n b\u7857 ?ng constraint/index:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Unique constraint}: \u273 ?\u7843 ?m b\u7843 ?o {\f1 id} l\u224 ? duy nh\u7845 ?t theo t\u7915 ?ng label.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Index}: t\u259 ?ng t\u7889 ?c truy v\u7845 ?n {\f1 MATCH (n \{id: ...\})} ho\u7863 ?c {\f1 MATCH (n:Email \{value: ...\})}.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u237 ? d\u7909 ? (tham kh\u7843 ?o cho Neo4j, mang t\u237 ?nh \u273 ?\u7883 ?nh h\u432 ?\u7899 ?ng):\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 CREATE CONSTRAINT email_id_unique IF NOT EXISTS\line
FOR (e:Email) REQUIRE e.id IS UNIQUE;\line
\line
CREATE CONSTRAINT url_id_unique IF NOT EXISTS\line
FOR (u:URL) REQUIRE u.id IS UNIQUE;\line
\line
CREATE CONSTRAINT ip_id_unique IF NOT EXISTS\line
FOR (i:IPAddress) REQUIRE i.id IS UNIQUE;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong ph\u7841 ?m vi \u273 ?\u7891 ? \u225 ?n, vi\u7879 ?c d\u249 ?ng {\f1 MERGE} + quy \u432 ?\u7899 ?c {\f1 id} \u273 ?\u227 ? gi\u250 ?p h\u7841 ?n ch\u7871 ? tr\u249 ?ng; ph\u7847 ?n constraint c\u243 ? th\u7875 ? tr\u236 ?nh b\u224 ?y nh\u432 ? m\u7897 ?t h\u432 ?\u7899 ?ng ho\u224 ?n thi\u7879 ?n.\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 1.3 Neo4j v\u224 ? ng\u244 ?n ng\u7919 ? Cypher\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.1 Gi\u7899 ?i thi\u7879 ?u Neo4j\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Neo4j l\u224 ? h\u7879 ? qu\u7843 ?n tr\u7883 ? c\u417 ? s\u7903 ? d\u7919 ? li\u7879 ?u \u273 ?\u7891 ? th\u7883 ? ph\u7893 ? bi\u7871 ?n, h\u7895 ? tr\u7907 ? m\u244 ? h\u236 ?nh Property Graph v\u224 ? cung c\u7845 ?p ng\u244 ?n ng\u7919 ? truy v\u7845 ?n Cypher. Neo4j t\u7889 ?i \u432 ?u h\u243 ?a vi\u7879 ?c duy\u7879 ?t c\u7841 ?nh (traversal) v\u224 ? h\u7895 ? tr\u7907 ? giao d\u7883 ?ch theo m\u244 ? h\u236 ?nh ACID, ph\u249 ? h\u7907 ?p cho c\u225 ?c b\u224 ?i to\u225 ?n m\u224 ? quan h\u7879 ? gi\u7919 ?a th\u7921 ?c th\u7875 ? \u273 ?\u243 ?ng vai tr\u242 ? trung t\u226 ?m.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong \u273 ?\u7891 ? \u225 ?n, backend Spring Boot k\u7871 ?t n\u7889 ?i Neo4j th\u244 ?ng qua driver (Bolt) v\u224 ? g\u7917 ?i truy v\u7845 ?n Cypher \u273 ?\u7875 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ingest d\u7919 ? li\u7879 ?u b\u7857 ?ng {\f1 MERGE}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Truy v\u7845 ?n th\u7889 ?ng k\u234 ? ph\u7909 ?c v\u7909 ? ph\u226 ?n t\u237 ?ch.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u7853 ?p nh\u7853 ?t thu\u7897 ?c t\u237 ?nh {\f1 riskScore}, {\f1 verdict}, v\u224 ? (t\u249 ?y ch\u7885 ?n) {\f1 layoutX/layoutY}.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong Neo4j, d\u7919 ? li\u7879 ?u \u273 ?\u432 ?\u7907 ?c t\u7893 ? ch\u7913 ?c theo:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Label} cho node (v\u237 ? d\u7909 ? {\f1 Email}, {\f1 URL}, {\f1 IPAddress}).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Relationship type} cho c\u7841 ?nh (v\u237 ? d\u7909 ? {\f1 CONTAINS_LINK}, {\f1 SENT_FROM}, {\f1 HOSTED_BY}).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Properties} key\u8211-value (v\u237 ? d\u7909 ? {\f1 value}, {\f1 riskScore}, {\f1 verdict}).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 C\u225 ?c th\u7921 ?c h\u224 ?nh t\u7889 ?t cho t\u237 ?nh nh\u7845 ?t qu\u225 ?n d\u7919 ? li\u7879 ?u (\u273 ?\u7883 ?nh h\u432 ?\u7899 ?ng tri\u7875 ?n khai):\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Chu\u7849 ?n h\u243 ?a \u273 ?\u7883 ?nh danh node (ID theo prefix nh\u432 ? {\f1 Email:<value>}).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab S\u7917 ? d\u7909 ?ng {\f1 MERGE} \u273 ?\u7875 ? tr\u225 ?nh t\u7841 ?o tr\u249 ?ng.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab (T\u249 ?y ch\u7885 ?n) t\u7841 ?o constraint/unique index cho {\f1 id} n\u7871 ?u tri\u7875 ?n khai production.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.2 C\u225 ?c l\u7879 ?nh Cypher c\u417 ? b\u7843 ?n\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 CREATE}: t\u7841 ?o node/relationship.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 MERGE}: t\u7841 ?o n\u7871 ?u ch\u432 ?a c\u243 ? (tr\u225 ?nh tr\u249 ?ng).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 MATCH}: truy v\u7845 ?n theo pattern.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 WHERE}: l\u7885 ?c \u273 ?i\u7873 ?u ki\u7879 ?n.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 RETURN}: tr\u7843 ? k\u7871 ?t qu\u7843 ?.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 SET}: c\u7853 ?p nh\u7853 ?t property.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 DELETE}/{\f1 DETACH DELETE}: x\u243 ?a.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u237 ? d\u7909 ? t\u7841 ?o d\u7919 ? li\u7879 ?u (t\u243 ?m t\u7855 ?t theo m\u244 ? h\u236 ?nh \u273 ?\u7891 ? \u225 ?n):\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MERGE (e:Email \{id: 'Email:' + $email, value: $email\})\line
MERGE (u:URL \{id: 'URL:' + $url, value: $url\})\line
MERGE (i:IPAddress \{id: 'IPAddress:' + $ip, value: $ip\})\line
MERGE (e)-[:CONTAINS_LINK]->(u)\line
MERGE (e)-[:SENT_FROM]->(i)\line
MERGE (u)-[:HOSTED_BY]->(i);\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.3 Truy v\u7845 ?n theo pattern\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Cypher cho ph\u233 ?p m\u244 ? t\u7843 ? tr\u7921 ?c quan pattern c\u7847 ?n t\u236 ?m. V\u237 ? d\u7909 ? truy v\u7871 ?t chu\u7895 ?i {\b Email \u8594 ? URL \u8594 ? IP}:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (e:Email)-[:CONTAINS_LINK]->(u:URL)-[:HOSTED_BY]->(i:IPAddress)\line
RETURN e.value AS email, u.value AS url, i.value AS ip;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u237 ? d\u7909 ? ph\u225 ?t hi\u7879 ?n {\b shared URL}:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (u:URL)<-[:CONTAINS_LINK]-(e:Email)\line
RETURN u.value, count(DISTINCT e) AS emailCount\line
ORDER BY emailCount DESC;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.4 Cypher n\u226 ?ng cao (OPTIONAL MATCH, WITH, EXISTS, COUNT)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong tri\u7875 ?n khai c\u7911 ?a \u273 ?\u7891 ? \u225 ?n, m\u7897 ?t s\u7889 ? k\u7929 ? thu\u7853 ?t Cypher quan tr\u7885 ?ng \u273 ?\u432 ?\u7907 ?c s\u7917 ? d\u7909 ?ng \u273 ?\u7875 ? ph\u7909 ?c v\u7909 ? ph\u226 ?n t\u237 ?ch:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b {\f1 OPTIONAL MATCH}}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u249 ?ng khi mu\u7889 ?n l\u7845 ?y d\u7919 ? li\u7879 ?u \u8220"c\u243 ? ho\u7863 ?c kh\u244 ?ng\u8221" (v\u237 ? d\u7909 ? Email c\u243 ? th\u7875 ? ch\u432 ?a c\u243 ? URL/IP).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Tr\u225 ?nh l\u224 ?m m\u7845 ?t d\u242 ?ng k\u7871 ?t qu\u7843 ? do thi\u7871 ?u quan h\u7879 ?.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b {\f1 WITH}}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u249 ?ng \u273 ?\u7875 ? gom nh\u243 ?m (aggregation), truy\u7873 ?n bi\u7871 ?n trung gian gi\u7919 ?a c\u225 ?c pha truy v\u7845 ?n.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab R\u7845 ?t h\u7919 ?u \u237 ?ch khi t\u237 ?nh to\u225 ?n score t\u7915 ?ng b\u432 ?\u7899 ?c.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b {\f1 EXISTS \{ MATCH ... \}}}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u249 ?ng \u273 ?\u7875 ? ki\u7875 ?m tra s\u7921 ? t\u7891 ?n t\u7841 ?i c\u7911 ?a m\u7897 ?t pattern con.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Trong \u273 ?\u7891 ? \u225 ?n, d\u249 ?ng \u273 ?\u7875 ? ki\u7875 ?m tra triad (tam gi\u225 ?c Email\u8211-URL\u8211-IP) tr\u432 ?\u7899 ?c khi ch\u7845 ?m \u273 ?i\u7875 ?m.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 4)\tx360\tab {\b {\f1 COUNT \{ (pattern) \}}}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u237 ?nh s\u7889 ? l\u7847 ?n xu\u7845 ?t hi\u7879 ?n c\u7911 ?a pattern ngay trong truy v\u7845 ?n.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u249 ?ng \u273 ?\u7875 ? ki\u7875 ?m tra shared URL/shared IP.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u237 ? d\u7909 ? (mang t\u237 ?nh gi\u7843 ?i th\u237 ?ch) ki\u7875 ?m tra triad:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (e:Email)\line
WITH e,\line
  EXISTS \{\line
    MATCH (e)-[:CONTAINS_LINK]->(:URL)-[:HOSTED_BY]->(i:IPAddress)\line
    MATCH (e)-[:SENT_FROM]->(i)\line
  \} AS hasTriad\line
RETURN e.value, hasTriad;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.5 Neo4j: ACID, giao d\u7883 ?ch v\u224 ? \u253 ? ngh\u297 ?a v\u7899 ?i d\u7919 ? li\u7879 ?u quan h\u7879 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Neo4j h\u7895 ? tr\u7907 ? giao d\u7883 ?ch theo m\u244 ? h\u236 ?nh ACID, gi\u250 ?p:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u225 ?c thao t\u225 ?c ingest/update (MERGE/SET) c\u243 ? t\u237 ?nh nh\u7845 ?t qu\u225 ?n.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Tr\u225 ?nh tr\u7841 ?ng th\u225 ?i \u8220"n\u7917 ?a ch\u7915 ?ng\u8221" khi m\u7897 ?t ph\u7847 ?n quan h\u7879 ? \u273 ?\u432 ?\u7907 ?c t\u7841 ?o c\u242 ?n ph\u7847 ?n kh\u225 ?c th\u7845 ?t b\u7841 ?i.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong ph\u7841 ?m vi demo, \u273 ?i\u7873 ?u n\u224 ?y gi\u250 ?p k\u7883 ?ch b\u7843 ?n ingest/analyze c\u243 ? th\u7875 ? ch\u7841 ?y l\u7863 ?p v\u224 ? quan s\u225 ?t \u273 ?\u432 ?\u7907 ?c k\u7871 ?t qu\u7843 ? \u7893 ?n \u273 ?\u7883 ?nh.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.6 Ki\u7871 ?n tr\u250 ?c Neo4j \u7903 ? m\u7913 ?c kh\u225 ?i qu\u225 ?t (ph\u7909 ?c v\u7909 ? thuy\u7871 ?t tr\u236 ?nh)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Neo4j l\u432 ?u tr\u7919 ? node/relationship d\u7841 ?ng c\u7845 ?u tr\u250 ?c li\u234 ?n k\u7871 ?t (adjacency) gi\u250 ?p traversal nhanh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Driver (Bolt) gi\u250 ?p \u7913 ?ng d\u7909 ?ng backend g\u7917 ?i query Cypher v\u224 ? nh\u7853 ?n k\u7871 ?t qu\u7843 ?.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Index/constraint gi\u250 ?p t\u259 ?ng t\u7889 ?c truy v\u7845 ?n theo thu\u7897 ?c t\u237 ?nh v\u224 ? \u273 ?\u7843 ?m b\u7843 ?o kh\u244 ?ng tr\u249 ?ng.\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 {\b H\u236 ?nh 1.3 (g\u7907 ?i \u253 ?)}: S\u417 ? \u273 ?\u7891 ? \u8220"Spring Boot \u8594 ? Bolt Driver \u8594 ? Neo4j\u8221" v\u224 ? c\u225 ?c l\u7899 ?p (Controller/Service/DB).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.7 Property Graph v\u224 ? RDF (tham kh\u7843 ?o m\u7903 ? r\u7897 ?ng)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Hai m\u244 ? h\u236 ?nh d\u7919 ? li\u7879 ?u \u273 ?\u7891 ? th\u7883 ? ph\u7893 ? bi\u7871 ?n:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Property Graph (Neo4j)}: node/relationship c\u243 ? properties v\u224 ? label/type.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b RDF/Triple Store}: d\u7919 ? li\u7879 ?u d\u7841 ?ng b\u7897 ? ba (subject\u8211-predicate\u8211-object), th\u432 ?\u7901 ?ng d\u249 ?ng trong semantic web.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong \u273 ?\u7891 ? \u225 ?n, property graph ph\u249 ? h\u7907 ?p h\u417 ?n v\u236 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7877 ? bi\u7875 ?u di\u7877 ?n node theo lo\u7841 ?i (Email/URL/IP).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7877 ? l\u432 ?u thu\u7897 ?c t\u237 ?nh ph\u7909 ?c v\u7909 ? demo ({\f1 riskScore}, {\f1 verdict}, {\f1 layoutX/Y}).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.3.8 T\u7889 ?i \u432 ?u truy v\u7845 ?n (kh\u225 ?i qu\u225 ?t)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7897 ?t s\u7889 ? nguy\u234 ?n t\u7855 ?c khi vi\u7871 ?t Cypher \u273 ?\u7875 ? tr\u225 ?nh truy v\u7845 ?n n\u7863 ?ng:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab B\u7855 ?t \u273 ?\u7847 ?u t\u7915 ? node c\u243 ? \u273 ?i\u7873 ?u ki\u7879 ?n l\u7885 ?c r\u245 ? (theo label ho\u7863 ?c property c\u243 ? index).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Gi\u7899 ?i h\u7841 ?n ph\u7841 ?m vi traversal (v\u237 ? d\u7909 ? ch\u7881 ? 2-hop/3-hop c\u7847 ?n thi\u7871 ?t).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Tr\u225 ?nh {\f1 MATCH (n)} kh\u244 ?ng \u273 ?i\u7873 ?u ki\u7879 ?n tr\u234 ?n \u273 ?\u7891 ? th\u7883 ? l\u7899 ?n.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u249 ?ng aggregation h\u7907 ?p l\u253 ? v\u224 ? ki\u7875 ?m so\u225 ?t {\f1 collect()}.\sa180\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 1.4 So s\u225 ?nh m\u244 ? h\u236 ?nh ER v\u224 ? m\u244 ? h\u236 ?nh Graph\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.4.1 M\u244 ? h\u236 ?nh ER trong CSDL quan h\u7879 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b M\u244 ? h\u236 ?nh ER (Entity\u8211-Relationship)} m\u244 ? t\u7843 ? d\u7919 ? li\u7879 ?u \u7903 ? m\u7913 ?c kh\u225 ?i ni\u7879 ?m b\u7857 ?ng th\u7921 ?c th\u7875 ?, thu\u7897 ?c t\u237 ?nh v\u224 ? m\u7889 ?i quan h\u7879 ?. Khi tri\u7875 ?n khai sang RDBMS, c\u225 ?c quan h\u7879 ? N\u8211-N th\u432 ?\u7901 ?ng c\u7847 ?n b\u7843 ?ng trung gian.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b C\u225 ?c th\u224 ?nh ph\u7847 ?n v\u224 ? k\u253 ? hi\u7879 ?u c\u417 ? b\u7843 ?n} (theo m\u244 ? t\u7843 ? kh\u225 ?i qu\u225 ?t):\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Entity: h\u236 ?nh ch\u7919 ? nh\u7853 ?t \u8594 ? b\u7843 ?ng.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Attribute: h\u236 ?nh oval \u8594 ? c\u7897 ?t.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Relationship: h\u236 ?nh thoi \u8594 ? th\u432 ?\u7901 ?ng \u273 ?\u432 ?\u7907 ?c hi\u7879 ?n th\u7921 ?c b\u7857 ?ng kh\u243 ?a ngo\u7841 ?i ho\u7863 ?c b\u7843 ?ng trung gian.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Quy t\u7855 ?c \u225 ?nh x\u7841 ? sang CSDL quan h\u7879 ? (Implementation Mapping)}\par}
