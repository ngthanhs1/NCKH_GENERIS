{\pard \ql \f0 \sa180 \li0 \fi0 [6] D3.js, \u8220"D3: Data-Driven Documents,\u8221" truy c\u7853 ?p 2026. [Online]. Available: {\field{\*\fldinst{HYPERLINK "https://d3js.org/"}}{\fldrslt{\ul
https://d3js.org/
}}}
\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 PH\u7908 ? L\u7908 ?C\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Ph\u7909 ? l\u7909 ?c A: Danh s\u225 ?ch API ch\u237 ?nh (t\u243 ?m t\u7855 ?t)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/health}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET|POST /api/graph/link}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/link-partial}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/analyze}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/analysis/email-risk}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/analysis/url-risk}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/analysis/ip-risk}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/full}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 POST /api/graph/layout/save}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 DELETE /api/graph/node?id=...}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ghi ch\u250 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 /api/graph/analyze}: c\u7853 ?p nh\u7853 ?t {\f1 riskScore} + {\f1 verdict} (SAFE/SUSPICIOUS/FRAUD/UNKNOWN) tr\u7921 ?c ti\u7871 ?p l\u234 ?n node (ph\u7909 ?c v\u7909 ? UI).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 /api/graph/analysis/*}: tr\u7843 ? v\u7873 ? th\u7889 ?ng k\u234 ? + indicators (ph\u7909 ?c v\u7909 ? ph\u226 ?n t\u237 ?ch chi ti\u7871 ?t/b\u225 ?o c\u225 ?o).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Ph\u7909 ? l\u7909 ?c B: M\u7897 ?t s\u7889 ? truy v\u7845 ?n Cypher minh h\u7885 ?a\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Shared URL}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (u:URL)<-[:CONTAINS_LINK]-(e:Email)\line
RETURN u.value, count(DISTINCT e) AS emailCount\line
ORDER BY emailCount DESC;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Shared IP}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (i:IPAddress)<-[:SENT_FROM]-(e:Email)\line
RETURN i.value, count(DISTINCT e) AS emailCount\line
ORDER BY emailCount DESC;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Trace Email \u8594 ? URL \u8594 ? IP}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (e:Email)-[:CONTAINS_LINK]->(u:URL)-[:HOSTED_BY]->(i:IPAddress)\line
RETURN e.value, u.value, i.value;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Ph\u7909 ? l\u7909 ?c C: Seed d\u7919 ? li\u7879 ?u demo (curl) cho KS1\u8211-KS4\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7909 ?c ti\u234 ?u: t\u7841 ?o d\u7919 ? li\u7879 ?u \u273 ?\u7875 ? demo/ch\u7909 ?p \u7843 ?nh theo \u273 ?\u250 ?ng c\u225 ?c k\u7883 ?ch b\u7843 ?n trong Ch\u432 ?\u417 ?ng 7:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b KS1}: 01 triad t\u7889 ?i thi\u7875 ?u (Email\u8211-URL\u8211-IP)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b KS2}: 01 chi\u7871 ?n d\u7883 ?ch shared URL (nhi\u7873 ?u Email \u8594 ? 01 URL)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b KS3}: 01 h\u7841 ? t\u7847 ?ng shared IP (nhi\u7873 ?u Email \u8594 ? 01 IP)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b KS4}: 01 t\u236 ?nh hu\u7889 ?ng thi\u7871 ?u triad (\u273 ?\u7875 ? minh h\u7885 ?a {\f1 UNKNOWN})\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 Ghi ch\u250 ?: d\u249 ?ng {\f1 --data-urlencode} \u273 ?\u7875 ? tr\u225 ?nh l\u7895 ?i k\u253 ? t\u7921 ? \u273 ?\u7863 ?c bi\u7879 ?t trong URL.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b A) Seed d\u7919 ? li\u7879 ?u}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 BASE="http://localhost:8080"\line
API="$BASE/api/graph"\line
\line
# KS1: 01 triad t\u7889 ?i thi\u7875 ?u\line
curl -G "$API/link" \\\line
  --data-urlencode "email=triad1@demo.local" \\\line
  --data-urlencode "url=http://min.example/one" \\\line
  --data-urlencode "ip=10.0.0.10"\line
\line
# KS2: shared URL (3 Email -> 1 URL)\line
curl -G "$API/link" \\\line
  --data-urlencode "email=camp1@demo.local" \\\line
  --data-urlencode "url=http://campaign.example/login" \\\line
  --data-urlencode "ip=10.0.0.21"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=camp2@demo.local" \\\line
  --data-urlencode "url=http://campaign.example/login" \\\line
  --data-urlencode "ip=10.0.0.22"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=camp3@demo.local" \\\line
  --data-urlencode "url=http://campaign.example/login" \\\line
  --data-urlencode "ip=10.0.0.23"\line
\line
# KS3: shared IP (3 Email -> 1 IP)\line
curl -G "$API/link" \\\line
  --data-urlencode "email=infra1@demo.local" \\\line
  --data-urlencode "url=http://infra.example/a" \\\line
  --data-urlencode "ip=10.0.0.30"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=infra2@demo.local" \\\line
  --data-urlencode "url=http://infra.example/b" \\\line
  --data-urlencode "ip=10.0.0.30"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=infra3@demo.local" \\\line
  --data-urlencode "url=http://infra.example/c" \\\line
  --data-urlencode "ip=10.0.0.30"\line
\line
# KS4: thi\u7871 ?u triad (Email + URL, kh\u244 ?ng c\u243 ? IP)\line
curl -G "$API/link-partial" \\\line
  --data-urlencode "email=orphan1@demo.local" \\\line
  --data-urlencode "url=http://orphan.example/only"\line
\line
# Ch\u7841 ?y analyze \u273 ?\u7875 ? c\u7853 ?p nh\u7853 ?t riskScore + verdict cho UI\line
curl "$API/analyze"\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b B) D\u7885 ?n d\u7919 ? li\u7879 ?u \u273 ?\u7875 ? seed l\u7841 ?i (kh\u244 ?ng c\u7847 ?n truy c\u7853 ?p Neo4j Browser)}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong h\u7879 ? th\u7889 ?ng c\u243 ? endpoint x\u243 ?a theo {\f1 id}:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 BASE="http://localhost:8080"\line
API="$BASE/api/graph"\line
\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:triad1@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=URL:http://min.example/one"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=IPAddress:10.0.0.10"\line
\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:camp1@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:camp2@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:camp3@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=URL:http://campaign.example/login"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=IPAddress:10.0.0.21"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=IPAddress:10.0.0.22"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=IPAddress:10.0.0.23"\line
\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:infra1@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:infra2@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:infra3@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=URL:http://infra.example/a"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=URL:http://infra.example/b"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=URL:http://infra.example/c"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=IPAddress:10.0.0.30"\line
\line
curl -X DELETE -G "$API/node" --data-urlencode "id=Email:orphan1@demo.local"\line
curl -X DELETE -G "$API/node" --data-urlencode "id=URL:http://orphan.example/only"\par}
