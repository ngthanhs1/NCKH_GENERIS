{\pard \ql \f0 \sa180 \li0 \fi0 \par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ghi ch\u250 ? quan tr\u7885 ?ng:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 /api/graph/analyze} tr\u7843 ? v\u7873 ? {\f1 verdict} theo b\u7897 ? nh\u227 ?n SAFE/SUSPICIOUS/FRAUD/UNKNOWN.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Nh\u243 ?m {\f1 /api/graph/analyze} \u225 ?p d\u7909 ?ng triad-gating v\u224 ? c\u7853 ?p nh\u7853 ?t property tr\u7921 ?c ti\u7871 ?p l\u234 ?n node (ph\u7909 ?c v\u7909 ? UI t\u244 ? m\u224 ?u).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Nh\u243 ?m {\f1 /api/graph/analysis/*} tr\u7843 ? v\u7873 ? verdict ti\u7871 ?ng Vi\u7879 ?t (GIAN L\u7852 ?N/\u272 ?\u193 ?NG NGHI NG\u7900 ?/AN TO\u192 ?N), {\f1 riskLevel}, {\f1 indicators} (v\u224 ? {\f1 riskScore} theo th\u7889 ?ng k\u234 ?) \u273 ?\u7875 ? ph\u7909 ?c v\u7909 ? gi\u7843 ?i th\u237 ?ch; nh\u243 ?m n\u224 ?y kh\u244 ?ng nh\u7857 ?m thay th\u7871 ? quy \u432 ?\u7899 ?c verdict c\u7911 ?a {\f1 /api/graph/analyze}.\sa180\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 CH\u431 ?\u416 ?NG 5: X\u194 ?Y D\u7920 ?NG V\u192 ? C\u192 ?I \u272 ?\u7862 ?T H\u7878 ? TH\u7888 ?NG\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 5.0 Y\u234 ?u c\u7847 ?u m\u244 ?i tr\u432 ?\u7901 ?ng v\u224 ? c\u244 ?ng c\u7909 ?\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Java Development Kit (JDK): {\b 17}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Neo4j: m\u7897 ?t instance ch\u7841 ?y s\u7861 ?n (local ho\u7863 ?c cloud)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u244 ?ng c\u7909 ? build: Maven ho\u7863 ?c Gradle (repo c\u243 ? s\u7861 ?n wrapper)\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong repo, phi\u234 ?n b\u7843 ?n ho\u224 ?n ch\u7881 ?nh \u273 ?\u7875 ? ch\u7841 ?y demo n\u7857 ?m trong th\u432 ? m\u7909 ?c {\f1 complete/}.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 5.0.1 Checklist tr\u432 ?\u7899 ?c khi ch\u7841 ?y demo\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u9744 ? \u272 ?\u227 ? c\u243 ? Neo4j \u273 ?ang ch\u7841 ?y (local/cloud)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u9744 ? C\u243 ? URI/username/password h\u7907 ?p l\u7879 ?\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u9744 ? \u272 ?\u227 ? export bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng NEO4J_*\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u9744 ? JVM 17 \u273 ?ang \u273 ?\u432 ?\u7907 ?c d\u249 ?ng (ho\u7863 ?c {\f1 JAVA_HOME} tr\u7887 ? v\u7873 ? JDK 17)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u9744 ? \u7912 ?ng d\u7909 ?ng Spring Boot ch\u7841 ?y \u7903 ? {\f1 localhost:8080}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u9744 ? G\u7885 ?i {\f1 /api/graph/health} tr\u7843 ? {\f1 status=connected}\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 {\b H\u236 ?nh 5.1 (screenshot)}: terminal ch\u7841 ?y {\f1 ./gradlew bootRun} v\u224 ? log \u8220"Started ServingWebContentApplication\u8221".\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 5.1 C\u224 ?i \u273 ?\u7863 ?t Backend\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 5.1.1 Model Layer\par}
{\pard \ql \f0 \sa180 \li0 \fi0 C\u225 ?c model ch\u237 ?nh:\par}
