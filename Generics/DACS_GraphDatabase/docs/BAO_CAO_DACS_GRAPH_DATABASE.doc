{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Tr\u234 ?n UI, node thi\u7871 ?u triad v\u7851 ?n t\u7891 ?n t\u7841 ?i trong graph nh\u432 ?ng kh\u244 ?ng b\u7883 ? g\u225 ?n nh\u227 ?n \u273 ?\u225 ?ng nghi.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.5 Ch\u7841 ?y ph\u226 ?n t\u237 ?ch\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 curl http://localhost:8080/api/graph/analyze\par}
{\pard \ql \f0 \sa180 \li0 \fi0 K\u7923 ? v\u7885 ?ng \u273 ?\u7885 ?c k\u7871 ?t qu\u7843 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab M\u7895 ?i ph\u7847 ?n t\u7917 ? tr\u7843 ? v\u7873 ? g\u7891 ?m {\f1 email} (id), {\f1 score}, {\f1 verdict}, {\f1 hasTriad}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab N\u7871 ?u {\f1 hasTriad=false} th\u236 ? {\f1 verdict} l\u224 ? {\f1 UNKNOWN} v\u224 ? {\f1 score=0}.\sa180\par}
