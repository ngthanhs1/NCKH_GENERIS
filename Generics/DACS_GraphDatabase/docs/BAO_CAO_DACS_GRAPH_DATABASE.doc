{\pard \ql \f0 \sa180 \li0 \fi0 \u221 ? ngh\u297 ?a nhanh:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GraphController} + {\f1 GraphQueryService}: ingest/analyze/full graph/layout (nh\u243 ?m {\f1 /api/graph/*}).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 Email/Url/IPAddress*}: CRUD v\u224 ? m\u244 ? h\u236 ?nh node t\u432 ?\u417 ?ng \u7913 ?ng.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 static/}: giao di\u7879 ?n D3 (graph) v\u224 ? trang report.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 5.2 C\u224 ?i \u273 ?\u7863 ?t Neo4j\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Khuy\u7871 ?n ngh\u7883 ? c\u7845 ?u h\u236 ?nh b\u7857 ?ng bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 export NEO4J_URI='neo4j+s://...'\line
export NEO4J_USERNAME='neo4j'\line
export NEO4J_PASSWORD='...'\line
export NEO4J_DATABASE='neo4j'\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong c\u7845 ?u h\u236 ?nh Spring Boot, c\u225 ?c gi\u225 ? tr\u7883 ? k\u7871 ?t n\u7889 ?i Neo4j \u273 ?\u432 ?\u7907 ?c \u273 ?\u7885 ?c t\u7915 ? bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng \u273 ?\u7875 ? tr\u225 ?nh hard-code m\u7853 ?t kh\u7849 ?u v\u224 ?o source.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 5.2.1 Gi\u7843 ?i th\u237 ?ch nhanh c\u225 ?c bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 NEO4J_URI}: \u273 ?\u7883 ?a ch\u7881 ? k\u7871 ?t n\u7889 ?i (v\u237 ? d\u7909 ? {\f1 neo4j://localhost:7687} ho\u7863 ?c {\f1 neo4j+s://...})\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 NEO4J_USERNAME}, {\f1 NEO4J_PASSWORD}: th\u244 ?ng tin \u273 ?\u259 ?ng nh\u7853 ?p\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 NEO4J_DATABASE}: t\u234 ?n database (th\u432 ?\u7901 ?ng l\u224 ? {\f1 neo4j})\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 {\b L\u432 ?u \u253 ? b\u7843 ?o m\u7853 ?t}: Kh\u244 ?ng commit m\u7853 ?t kh\u7849 ?u th\u7853 ?t l\u234 ?n repo; \u432 ?u ti\u234 ?n {\f1 .env} \u7903 ? m\u225 ?y c\u225 ? nh\u226 ?n v\u224 ? \u273 ?\u432 ?a v\u224 ?o bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng khi ch\u7841 ?y.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 5.3 Build v\u224 ? ch\u7841 ?y \u7913 ?ng d\u7909 ?ng\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 5.3.1 Ch\u7841 ?y b\u7857 ?ng Gradle Wrapper (khuy\u7871 ?n ngh\u7883 ?)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 T\u7841 ?i th\u432 ? m\u7909 ?c {\f1 complete/}:\par}
{\pard \ql \f0 \sa180 \li720 \fi0 L\u432 ?u \u253 ?: Gradle c\u7911 ?a project y\u234 ?u c\u7847 ?u JVM 17+. N\u7871 ?u m\u244 ?i tr\u432 ?\u7901 ?ng \u273 ?ang m\u7863 ?c \u273 ?\u7883 ?nh Java 11, c\u7847 ?n tr\u7887 ? {\f1 JAVA_HOME} sang JDK 17.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64\line
export PATH="$JAVA_HOME/bin:$PATH"\line
\line
./gradlew bootRun\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Sau khi ch\u7841 ?y, c\u243 ? th\u7875 ? ki\u7875 ?m tra nhanh:\par}
