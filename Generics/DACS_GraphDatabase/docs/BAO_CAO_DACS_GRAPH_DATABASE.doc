{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Sau khi analyze, URL/Email c\u243 ? th\u7875 ? t\u259 ?ng \u273 ?i\u7875 ?m theo rule shared URL.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 G\u7907 ?i \u253 ? t\u7841 ?o th\u234 ?m 1\u8211-2 Email n\u7919 ?a \u273 ?\u7875 ? th\u7845 ?y r\u245 ? hi\u7879 ?u \u7913 ?ng (t\u249 ?y th\u7901 ?i gian demo).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 7.4.3 K\u7883 ?ch b\u7843 ?n 3: T\u7841 ?o shared IP (h\u7841 ? t\u7847 ?ng g\u7917 ?i)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 BASE="http://localhost:8080"\line
API="$BASE/api/graph"\line
\line
