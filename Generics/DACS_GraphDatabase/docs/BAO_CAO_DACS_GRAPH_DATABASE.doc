{
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 \u272 ?i\u7873 ?u ki\u7879 ?n (khi \u273 ?\u227 ? \u273 ?\u7911 ? triad)\par}
\cell}
{{\pard\intbl \qr \f0 \sa0 \li0 \fi0 \u272 ?i\u7875 ?m\par}
\cell}
