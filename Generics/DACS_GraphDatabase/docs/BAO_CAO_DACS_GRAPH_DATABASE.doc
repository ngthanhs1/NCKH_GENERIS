{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b Gradle/Maven l\u7895 ?i phi\u234 ?n b\u7843 ?n Java}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7845 ?u hi\u7879 ?u: build fail y\u234 ?u c\u7847 ?u Java 17.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u225 ?ch x\u7917 ? l\u253 ?: \u273 ?\u7863 ?t {\f1 JAVA_HOME} tr\u7887 ? v\u7873 ? JDK 17 tr\u432 ?\u7899 ?c khi ch\u7841 ?y.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b Graph kh\u244 ?ng hi\u7879 ?n \u273 ?\u7911 ? d\u7919 ? li\u7879 ?u tr\u234 ?n UI}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7845 ?u hi\u7879 ?u: UI tr\u7889 ?ng ho\u7863 ?c thi\u7871 ?u node.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u225 ?ch x\u7917 ? l\u253 ?: g\u7885 ?i {\f1 /api/graph/full} \u273 ?\u7875 ? x\u225 ?c nh\u7853 ?n backend c\u243 ? d\u7919 ? li\u7879 ?u; n\u7871 ?u c\u243 ? th\u236 ? ki\u7875 ?m tra console log c\u7911 ?a browser.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 4)\tx360\tab {\b Email/URL/IP kh\u244 ?ng \u273 ?\u432 ?\u7907 ?c k\u7871 ?t lu\u7853 ?n (UNKNOWN) d\u249 ? mong \u273 ?\u7907 ?i}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7845 ?u hi\u7879 ?u: {\f1 hasTriad=false}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u225 ?ch x\u7917 ? l\u253 ?: ki\u7875 ?m tra \u273 ?\u227 ? t\u7841 ?o \u273 ?\u7911 ? 3 c\u7841 ?nh \u273 ?\u7875 ? th\u224 ?nh triad (Email\u8211-URL, Email\u8211-IP, URL\u8211-IP).\sa180\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 K\u7870 ?T LU\u7852 ?N\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Nh\u7919 ?ng k\u7871 ?t qu\u7843 ? \u273 ?\u7841 ?t \u273 ?\u432 ?\u7907 ?c\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u236 ?m hi\u7875 ?u l\u253 ? thuy\u7871 ?t Graph DB v\u224 ? Neo4j/Cypher.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab X\u226 ?y d\u7921 ?ng m\u244 ? h\u236 ?nh Email\u8211-URL\u8211-IP v\u224 ? ingest d\u7919 ? li\u7879 ?u b\u7857 ?ng {\f1 MERGE}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Minh h\u7885 ?a ph\u226 ?n t\u237 ?ch r\u7911 ?i ro rule-based v\u224 ? tr\u7921 ?c quan h\u243 ?a b\u7857 ?ng D3.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 \u221 ? ngh\u297 ?a c\u7911 ?a Graph Database trong b\u224 ?i to\u225 ?n\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ph\u249 ? h\u7907 ?p cho truy v\u7845 ?n theo pattern v\u224 ? truy v\u7871 ?t multi-hop.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 H\u432 ?\u7899 ?ng ph\u225 ?t tri\u7875 ?n\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab B\u7893 ? sung node/relationship (Domain, ASN, User/Recipient...).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab B\u7893 ? sung thu\u7853 ?t to\u225 ?n c\u7897 ?ng \u273 ?\u7891 ?ng (community detection), centrality.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ho\u224 ?n thi\u7879 ?n validation v\u224 ? ki\u7875 ?m th\u7917 ? API.\sa180\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 T\u192 ?I LI\u7878 ?U THAM KH\u7842 ?O\par}
{\pard \ql \f0 \sa180 \li720 \fi0 Danh m\u7909 ?c d\u432 ?\u7899 ?i \u273 ?\u226 ?y theo d\u7841 ?ng IEEE (b\u7841 ?n c\u243 ? th\u7875 ? ch\u7881 ?nh l\u7841 ?i cho \u273 ?\u250 ?ng y\u234 ?u c\u7847 ?u tr\u432 ?\u7901 ?ng).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 [1] Neo4j Documentation, \u8220"Neo4j Cypher Manual,\u8221" truy c\u7853 ?p 2026. [Online]. Available: {\field{\*\fldinst{HYPERLINK "https://neo4j.com/docs/"}}{\fldrslt{\ul
https://neo4j.com/docs/
}}}
\par}
