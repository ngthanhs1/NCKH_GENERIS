{\pard \ql \f0 \sa180 \li720 \fi0 {\b H\u236 ?nh 7.2 (minh h\u7885 ?a)}: D\u7919 ? li\u7879 ?u demo sau ingest (KS1\u8211-KS4), tr\u432 ?\u7899 ?c khi analyze. Nh\u243 ?m c\u243 ? th\u7875 ? thay \u7843 ?nh minh h\u7885 ?a b\u7857 ?ng screenshot UI th\u7853 ?t khi ho\u224 ?n thi\u7879 ?n b\u225 ?o c\u225 ?o.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\pict\pngblip\picw1200\pich720\picwgoal24000\pichgoal14400 }\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 7.4.1 K\u7883 ?ch b\u7843 ?n 1: T\u7841 ?o m\u7897 ?t triad t\u7889 ?i thi\u7875 ?u\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 BASE="http://localhost:8080"\line
API="$BASE/api/graph"\line
\line
curl -G "$API/link" \\\line
  --data-urlencode "email=triad1@demo.local" \\\line
  --data-urlencode "url=http://min.example/one" \\\line
  --data-urlencode "ip=10.0.0.10"\par}
{\pard \ql \f0 \sa180 \li0 \fi0 K\u7923 ? v\u7885 ?ng:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u7841 ?o \u273 ?\u7911 ? 3 node v\u224 ? 3 relationship, h\u236 ?nh th\u224 ?nh tam gi\u225 ?c Email\u8211-URL\u8211-IP.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?\u7889 ?i chi\u7871 ?u b\u7857 ?ng Cypher (minh h\u7885 ?a):\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (e:Email \{value:"triad1@demo.local"\})-[r1:CONTAINS_LINK]->(u:URL)\line
MATCH (e)-[r2:SENT_FROM]->(i:IPAddress)\line
MATCH (u)-[r3:HOSTED_BY]->(i)\line
RETURN e,u,i,r1,r2,r3;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 7.4.2 K\u7883 ?ch b\u7843 ?n 2: T\u7841 ?o shared URL (campaign)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 T\u7841 ?o shared URL:\par}
