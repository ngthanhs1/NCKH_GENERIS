{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Attribute \u8594 ? Column\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Relationship 1\u8211-N \u8594 ? FK \u273 ?\u7863 ?t \u7903 ? ph\u237 ?a N\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Relationship N\u8211-N \u8594 ? Table trung gian (join table) g\u7891 ?m 2 FK\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 V\u7899 ?i b\u224 ?i to\u225 ?n \u273 ?\u7891 ? \u225 ?n (Email\u8211-URL\u8211-IP), quan h\u7879 ? th\u432 ?\u7901 ?ng l\u224 ? N\u8211-N, do \u273 ?\u243 ? n\u7871 ?u \u7903 ? RDBMS s\u7869 ? c\u7847 ?n nhi\u7873 ?u join table.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.4.2 M\u244 ? h\u236 ?nh Graph t\u432 ?\u417 ?ng \u273 ?\u432 ?\u417 ?ng\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong m\u244 ? h\u236 ?nh Graph (Property Graph):\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 Email}, {\f1 URL}, {\f1 IPAddress} l\u224 ? node.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Quan h\u7879 ? l\u224 ? relationship c\u243 ? h\u432 ?\u7899 ?ng:\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab {\f1 (:Email)-[:CONTAINS_LINK]->(:URL)}\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab {\f1 (:Email)-[:SENT_FROM]->(:IPAddress)}\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab {\f1 (:URL)-[:HOSTED_BY]->(:IPAddress)}\sa180\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 S\u417 ? \u273 ?\u7891 ? minh h\u7885 ?a:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 flowchart LR\line
  E[(:Email)] -->|CONTAINS_LINK| U[(:URL)]\line
  E -->|SENT_FROM| I[(:IPAddress)]\line
  U -->|HOSTED_BY| I\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 1.4.3 Nh\u7853 ?n x\u233 ?t v\u224 ? so s\u225 ?nh\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u7902 ? RDBMS, truy v\u7845 ?n multi-hop th\u432 ?\u7901 ?ng c\u7847 ?n nhi\u7873 ?u JOIN \u8594 ? k\u7871 ? ho\u7841 ?ch truy v\u7845 ?n ph\u7913 ?c t\u7841 ?p v\u224 ? c\u243 ? th\u7875 ? t\u7841 ?o nhi\u7873 ?u d\u7919 ? li\u7879 ?u trung gian.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u7902 ? Graph DB, truy v\u7845 ?n pattern \u273 ?\u432 ?\u7907 ?c m\u244 ? t\u7843 ? tr\u7921 ?c ti\u7871 ?p v\u224 ? duy\u7879 ?t theo c\u7841 ?nh.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ph\u7847 ?n so s\u225 ?nh hi\u7879 ?u n\u259 ?ng l\u253 ? thuy\u7871 ?t JOIN vs traversal \u273 ?\u432 ?\u7907 ?c tr\u236 ?nh b\u224 ?y chi ti\u7871 ?t \u7903 ? Ch\u432 ?\u417 ?ng 6.\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 CH\u431 ?\u416 ?NG 2: PH\u194 ?N T\u205 ?CH B\u192 ?I TO\u193 ?N MINH H\u7884 ?A\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 2.1 Gi\u7899 ?i thi\u7879 ?u b\u224 ?i to\u225 ?n ph\u225 ?t hi\u7879 ?n gian l\u7853 ?n/phishing\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Phishing/scam th\u432 ?\u7901 ?ng kh\u244 ?ng ch\u7881 ? \u273 ?\u7871 ?n t\u7915 ? m\u7897 ?t d\u7845 ?u hi\u7879 ?u \u273 ?\u417 ?n l\u7867 ? (m\u7897 ?t URL l\u7841 ?, m\u7897 ?t email l\u7841 ?), m\u224 ? th\u7875 ? hi\u7879 ?n qua {\b chu\u7895 ?i li\u234 ?n k\u7871 ?t h\u224 ?nh vi} v\u224 ? {\b t\u7847 ?n su\u7845 ?t d\u249 ?ng chung} trong m\u7897 ?t m\u7841 ?ng l\u432 ?\u7899 ?i: nhi\u7873 ?u email tr\u7887 ? c\u249 ?ng URL (campaign), nhi\u7873 ?u email xu\u7845 ?t ph\u225 ?t t\u7915 ? c\u249 ?ng IP (h\u7841 ? t\u7847 ?ng g\u7917 ?i), nhi\u7873 ?u URL c\u249 ?ng host tr\u234 ?n m\u7897 ?t IP (hub hosting).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?\u7891 ? \u225 ?n ch\u7885 ?n m\u244 ? h\u236 ?nh t\u7889 ?i gi\u7843 ?n Email\u8211-URL\u8211-IP \u273 ?\u7875 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7877 ? minh h\u7885 ?a quan h\u7879 ? v\u224 ? pattern.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7877 ? tr\u236 ?nh b\u224 ?y \u432 ?u th\u7871 ? graph traversal.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7877 ? m\u7903 ? r\u7897 ?ng v\u7873 ? sau.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 2.1.1 \u272 ?\u7897 ?ng c\u417 ? l\u7921 ?a ch\u7885 ?n b\u224 ?i to\u225 ?n\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong th\u7921 ?c t\u7871 ?, m\u7897 ?t chi\u7871 ?n d\u7883 ?ch phishing c\u243 ? th\u7875 ? c\u243 ? nhi\u7873 ?u bi\u7871 ?n th\u7875 ?: thay \u273 ?\u7893 ?i email g\u7917 ?i, thay \u273 ?\u7893 ?i URL, thay \u273 ?\u7893 ?i h\u7841 ? t\u7847 ?ng IP/hosting. Khi nh\u236 ?n t\u7915 ?ng th\u7921 ?c th\u7875 ? ri\u234 ?ng l\u7867 ?, r\u7845 ?t kh\u243 ? k\u7871 ?t lu\u7853 ?n. Tuy nhi\u234 ?n, n\u7871 ?u nh\u236 ?n tr\u234 ?n \u8220"b\u7843 ?n \u273 ?\u7891 ? li\u234 ?n k\u7871 ?t\u8221", ta c\u243 ? th\u7875 ? th\u7845 ?y c\u225 ?c d\u7845 ?u hi\u7879 ?u:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Nhi\u7873 ?u Email c\u249 ?ng tr\u7887 ? v\u7873 ? m\u7897 ?t URL (campaign ph\u225 ?t t\u225 ?n).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Nhi\u7873 ?u Email c\u249 ?ng g\u7917 ?i t\u7915 ? m\u7897 ?t IP (h\u7841 ? t\u7847 ?ng spam/botnet).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Nhi\u7873 ?u URL c\u249 ?ng host tr\u234 ?n m\u7897 ?t IP (hosting hub).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?\u226 ?y l\u224 ? l\u253 ? do nh\u243 ?m ch\u250 ?ng em ch\u7885 ?n Graph Database: truy v\u7845 ?n v\u224 ? gi\u7843 ?i th\u237 ?ch c\u225 ?c li\u234 ?n k\u7871 ?t s\u7869 ? tr\u7921 ?c quan h\u417 ?n.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 2.1.2 Ph\u7841 ?m vi b\u224 ?i to\u225 ?n trong \u273 ?\u7891 ? \u225 ?n\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ph\u7841 ?m vi \u273 ?\u7891 ? \u225 ?n \u273 ?\u432 ?\u7907 ?c gi\u7899 ?i h\u7841 ?n \u273 ?\u7875 ? ph\u7909 ?c v\u7909 ? m\u7909 ?c ti\u234 ?u h\u7885 ?c t\u7853 ?p v\u224 ? demo:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ch\u7881 ? m\u244 ? h\u236 ?nh h\u243 ?a 3 lo\u7841 ?i node: {\f1 Email}, {\f1 URL}, {\f1 IPAddress}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ch\u7881 ? m\u244 ? h\u236 ?nh h\u243 ?a 3 lo\u7841 ?i relationship: {\f1 CONTAINS_LINK}, {\f1 SENT_FROM}, {\f1 HOSTED_BY}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Thu\u7853 ?t to\u225 ?n ph\u226 ?n t\u237 ?ch r\u7911 ?i ro l\u224 ? rule-based (kh\u244 ?ng d\u249 ?ng ML).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 C\u225 ?c m\u7903 ? r\u7897 ?ng (ngo\u224 ?i ph\u7841 ?m vi hi\u7879 ?n t\u7841 ?i) s\u7869 ? \u273 ?\u432 ?\u7907 ?c \u273 ?\u7873 ? xu\u7845 ?t \u7903 ? ph\u7847 ?n h\u432 ?\u7899 ?ng ph\u225 ?t tri\u7875 ?n.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 2.1.3 D\u7919 ? li\u7879 ?u \u273 ?\u7847 ?u v\u224 ?o v\u224 ? gi\u7843 ? \u273 ?\u7883 ?nh\par}
{\pard \ql \f0 \sa180 \li0 \fi0 D\u7919 ? li\u7879 ?u \u273 ?\u7847 ?u v\u224 ?o \u273 ?\u432 ?\u7907 ?c nh\u7853 ?p qua API (d\u7841 ?ng demo), g\u7891 ?m c\u225 ?c chu\u7895 ?i:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email: v\u237 ? d\u7909 ? {\f1 scam@test.com}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab URL: v\u237 ? d\u7909 ? {\f1 http://fake-bank.com}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab IP: v\u237 ? d\u7909 ? {\f1 192.168.1.10}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 H\u7879 ? th\u7889 ?ng chu\u7849 ?n h\u243 ?a \u273 ?\u7883 ?nh danh theo quy \u432 ?\u7899 ?c:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 Email:<value>}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 URL:<value>}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 IPAddress:<value>}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7909 ?c ti\u234 ?u c\u7911 ?a quy \u432 ?\u7899 ?c n\u224 ?y l\u224 ? tr\u225 ?nh tr\u249 ?ng node khi ingest v\u224 ? l\u224 ?m r\u245 ? \u8220"m\u7897 ?t th\u7921 ?c th\u7875 ? \u8211- m\u7897 ?t node\u8221".\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 2.2 Ph\u226 ?n t\u237 ?ch y\u234 ?u c\u7847 ?u h\u7879 ? th\u7889 ?ng\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 2.2.1 Y\u234 ?u c\u7847 ?u ch\u7913 ?c n\u259 ?ng\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b Ingest d\u7919 ? li\u7879 ?u}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u7841 ?o graph \u273 ?\u7847 ?y \u273 ?\u7911 ?: {\f1 GET/POST /api/graph/link?email=...&url=...&ip=...}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u7841 ?o graph t\u7915 ?ng ph\u7847 ?n: {\f1 GET /api/graph/link-partial?email=...&url=...&ip=...}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b Ph\u226 ?n t\u237 ?ch r\u7911 ?i ro (rule-based)}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ch\u7841 ?y ph\u226 ?n t\u237 ?ch t\u7893 ?ng quan v\u224 ? c\u7853 ?p nh\u7853 ?t node: {\f1 GET /api/graph/analyze}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ngo\u224 ?i ra, h\u7879 ? th\u7889 ?ng c\u242 ?n c\u243 ? nh\u243 ?m API ph\u226 ?n t\u237 ?ch chi ti\u7871 ?t theo t\u7915 ?ng lo\u7841 ?i node:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/analysis/email-risk}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/analysis/url-risk}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 GET /api/graph/analysis/ip-risk}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ghi ch\u250 ?: nh\u243 ?m {\f1 /api/graph/analyze} d\u249 ?ng quy \u432 ?\u7899 ?c {\f1 verdict} (SAFE/SUSPICIOUS/FRAUD/UNKNOWN) v\u224 ? \u225 ?p d\u7909 ?ng triad-gating; nh\u243 ?m {\f1 /api/graph/analysis/*} tr\u7843 ? v\u7873 ? c\u225 ?c tr\u432 ?\u7901 ?ng {\f1 riskLevel}, {\f1 indicators} v\u224 ? nh\u227 ?n verdict ti\u7871 ?ng Vi\u7879 ?t ph\u7909 ?c v\u7909 ? ph\u226 ?n t\u237 ?ch chi ti\u7871 ?t.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b Cung c\u7845 ?p d\u7919 ? li\u7879 ?u cho tr\u7921 ?c quan h\u243 ?a}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab L\u7845 ?y d\u7919 ? li\u7879 ?u graph: {\f1 GET /api/graph/full}\par}
