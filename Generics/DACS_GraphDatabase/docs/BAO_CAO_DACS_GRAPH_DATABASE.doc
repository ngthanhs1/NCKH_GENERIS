\intbl\row}
{\pard \ql \f0 \sa180 \li0 \fi0 \par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 3.4 Bi\u7875 ?u \u273 ?\u7891 ? Sequence\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 3.4.1 Sequence: Ingest (t\u7841 ?o d\u7919 ? li\u7879 ?u)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 sequenceDiagram\line
  actor User\line
  participant FE as Frontend\line
  participant API as GraphController\line
  participant SVC as GraphQueryService\line
  participant DB as Neo4j\line
\line
  User->>FE: Nh\u7853 ?p email/url/ip\line
  FE->>API: /api/graph/link ho\u7863 ?c /api/graph/link-partial\line
  API->>SVC: linkEmailUrlIp(...) / linkPartial(...)\line
  SVC->>DB: Cypher MERGE nodes + relationships\line
  DB-->>SVC: OK\line
  SVC-->>API: OK\line
  API-->>FE: Response\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 3.4.2 Sequence: Analyze (ch\u7845 ?m \u273 ?i\u7875 ?m + g\u225 ?n nh\u227 ?n)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 sequenceDiagram\line
  actor User\line
  participant FE as Frontend\line
  participant API as GraphController\line
  participant SVC as GraphQueryService\line
  participant DB as Neo4j\line
\line
  User->>FE: M\u7903 ? UI/Report (ho\u7863 ?c b\u7845 ?m Refresh)\line
  FE->>API: GET /api/graph/analyze (t\u7921 ? \u273 ?\u7897 ?ng)\line
  API->>SVC: analyzeRisk()\line
  SVC->>DB: MATCH/OPTIONAL MATCH + t\u237 ?nh score\line
  SVC->>DB: SET riskScore, verdict\line
  DB-->>SVC: Updated\line
  SVC-->>API: Danh s\u225 ?ch Email k\u7871 ?t qu\u7843 ?\line
  API-->>FE: JSON\line
  FE->>API: GET /api/graph/full\line
  API-->>FE: nodes + links (\u273 ?\u227 ? c\u243 ? verdict/score)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 3.5 Bi\u7875 ?u \u273 ?\u7891 ? ho\u7841 ?t \u273 ?\u7897 ?ng (Activity Diagram)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Bi\u7875 ?u \u273 ?\u7891 ? ho\u7841 ?t \u273 ?\u7897 ?ng m\u244 ? t\u7843 ? lu\u7891 ?ng thao t\u225 ?c ch\u237 ?nh c\u7911 ?a ng\u432 ?\u7901 ?i d\u249 ?ng khi demo:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 flowchart TD\line
  S([Start]) --> I[Nh\u7853 ?p email/url/ip]\line
  I --> L\{\u272 ?\u7911 ? 3 tr\u432 ?\u7901 ?ng?\}\line
  L -- C\u243 ? --> A1[G\u7885 ?i /api/graph/link]\line
  L -- Kh\u244 ?ng --> A2[G\u7885 ?i /api/graph/link-partial]\line
  A1 --> R1[Neo4j MERGE node + relationship]\line
  A2 --> R1\line
  R1 --> AN[G\u7885 ?i /api/graph/analyze (UI t\u7921 ? \u273 ?\u7897 ?ng khi load/refresh)]\line
  AN --> R2[Neo4j SET riskScore + verdict]\line
  R2 --> V[UI g\u7885 ?i /api/graph/full \u273 ?\u7875 ? v\u7869 ? graph]\line
  V --> E([End])\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 3.6 S\u417 ? \u273 ?\u7891 ? lu\u7891 ?ng d\u7919 ? li\u7879 ?u (Data Flow)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u7902 ? m\u7913 ?c kh\u225 ?i qu\u225 ?t, h\u7879 ? th\u7889 ?ng c\u243 ? 3 lu\u7891 ?ng d\u7919 ? li\u7879 ?u ch\u237 ?nh:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b Ingest}: Client g\u7917 ?i input (email/url/ip) \u8594 ? Backend chuy\u7875 ?n th\u224 ?nh Cypher {\f1 MERGE} \u8594 ? Neo4j l\u432 ?u node/c\u7841 ?nh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b Analyze}: Client g\u7885 ?i analyze \u8594 ? Backend truy v\u7845 ?n th\u7889 ?ng k\u234 ? l\u226 ?n c\u7853 ?n + triad \u8594 ? Neo4j c\u7853 ?p nh\u7853 ?t thu\u7897 ?c t\u237 ?nh verdict/score.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b Visualize}: Client g\u7885 ?i full graph \u8594 ? Backend tr\u7843 ? JSON nodes/links \u8594 ? D3 hi\u7875 ?n th\u7883 ?.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 flowchart LR\line
  U[User] --> FE[Frontend]\line
  FE -->|Input: email/url/ip| API[REST API]\line
  API -->|MERGE/MATCH/SET| DB[(Neo4j)]\line
  DB -->|Nodes/Links + Properties| API\line
  API -->|JSON| FE\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 3.7 R\u224 ?ng bu\u7897 ?c v\u224 ? y\u234 ?u c\u7847 ?u phi ch\u7913 ?c n\u259 ?ng (b\u7893 ? sung)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b T\u237 ?nh nh\u7845 ?t qu\u225 ?n d\u7919 ? li\u7879 ?u}: c\u249 ?ng m\u7897 ?t th\u7921 ?c th\u7875 ? ch\u7881 ? c\u243 ? m\u7897 ?t node (d\u7921 ?a tr\u234 ?n {\f1 id} chu\u7849 ?n h\u243 ?a + {\f1 MERGE}).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Kh\u7843 ? n\u259 ?ng quan s\u225 ?t}: c\u243 ? {\f1 health} endpoint v\u224 ? trang report.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b T\u237 ?nh t\u225 ?i l\u7853 ?p demo}: c\u225 ?c k\u7883 ?ch b\u7843 ?n ingest/analyze n\u234 ?n ch\u7841 ?y l\u7863 ?p l\u7841 ?i v\u224 ? cho k\u7871 ?t qu\u7843 ? gi\u7843 ?i th\u237 ?ch \u273 ?\u432 ?\u7907 ?c.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b B\u7843 ?o m\u7853 ?t c\u7845 ?u h\u236 ?nh}: th\u244 ?ng tin k\u7871 ?t n\u7889 ?i DB (URI/username/password) kh\u244 ?ng hard-code.\sa180\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 CH\u431 ?\u416 ?NG 4: THI\u7870 ?T K\u7870 ? H\u7878 ? TH\u7888 ?NG\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 4.1 Ki\u7871 ?n tr\u250 ?c t\u7893 ?ng th\u7875 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ki\u7871 ?n tr\u250 ?c 3 t\u7847 ?ng:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Frontend}: HTML/CSS/JS + D3.js (render graph, filter, report)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Backend}: Spring Boot REST API\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Database}: Neo4j Graph DB\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.1.1 S\u417 ? \u273 ?\u7891 ? ki\u7871 ?n tr\u250 ?c (minh h\u7885 ?a)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 flowchart LR\line
  subgraph Client\line
    UI["Index + Report (D3.js)"]\line
  end\line
\line
  subgraph Server\line
    API["Spring Boot REST API"]\line
    SVC["Service: GraphQueryService"]\line
  end\line
\line
  DB[(Neo4j)]\line
\line
  UI <--> |HTTP JSON| API\line
  API --> SVC\line
  SVC <--> |Bolt + Cypher| DB\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.1.2 Nguy\u234 ?n t\u7855 ?c thi\u7871 ?t k\u7871 ?\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u272 ?\u7843 ?m b\u7843 ?o d\u7919 ? li\u7879 ?u kh\u244 ?ng tr\u249 ?ng: d\u249 ?ng {\f1 MERGE} khi ingest.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u272 ?\u7883 ?nh danh th\u7889 ?ng nh\u7845 ?t theo prefix ({\f1 Email:}, {\f1 URL:}, {\f1 IPAddress:}) \u273 ?\u7875 ? li\u234 ?n k\u7871 ?t \u7893 ?n \u273 ?\u7883 ?nh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u225 ?ch b\u7841 ?ch:\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab API t\u7893 ?ng quan ph\u7909 ?c v\u7909 ? UI graph: {\f1 /api/graph/full}, {\f1 /api/graph/analyze}.\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab API ph\u226 ?n t\u237 ?ch chi ti\u7871 ?t ph\u7909 ?c v\u7909 ? b\u225 ?o c\u225 ?o/di\u7877 ?n gi\u7843 ?i: {\f1 /api/graph/analysis/*}.\sa180\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 4.2 Thi\u7871 ?t k\u7871 ? m\u244 ? h\u236 ?nh d\u7919 ? li\u7879 ?u \u273 ?\u7891 ? th\u7883 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.2.1 Thi\u7871 ?t k\u7871 ? Node\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email node: label {\f1 Email}, properties: {\f1 id}, {\f1 value}, {\f1 riskScore}, {\f1 verdict}, (t\u249 ?y ch\u7885 ?n {\f1 layoutX/layoutY})\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab URL node: label {\f1 URL}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab IP node: label {\f1 IPAddress}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong tri\u7875 ?n khai hi\u7879 ?n t\u7841 ?i, {\f1 riskScore} v\u224 ? {\f1 verdict} l\u224 ? properties \u273 ?\u432 ?\u7907 ?c c\u7853 ?p nh\u7853 ?t b\u7903 ?i API ph\u226 ?n t\u237 ?ch t\u7893 ?ng quan {\f1 GET /api/graph/analyze}. {\f1 layoutX/layoutY} \u273 ?\u432 ?\u7907 ?c d\u249 ?ng \u273 ?\u7875 ? l\u432 ?u v\u7883 ? tr\u237 ? node sau k\u233 ?o th\u7843 ? tr\u234 ?n UI (n\u7871 ?u ng\u432 ?\u7901 ?i d\u249 ?ng b\u7845 ?m l\u432 ?u).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?\u7883 ?nh danh duy nh\u7845 ?t:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 Email:<value>}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 URL:<value>}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 IPAddress:<value>}\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.2.2 Thi\u7871 ?t k\u7871 ? Relationship\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 CONTAINS_LINK} (Email \u8594 ? URL)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 SENT_FROM} (Email \u8594 ? IP)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 HOSTED_BY} (URL \u8594 ? IP)\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.2.3 S\u417 ? \u273 ?\u7891 ? Graph t\u7893 ?ng th\u7875 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 flowchart LR\line
