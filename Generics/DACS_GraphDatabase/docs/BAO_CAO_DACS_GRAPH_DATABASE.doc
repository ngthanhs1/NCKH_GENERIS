  --data-urlencode "ip=10.0.0.30"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=infra2@demo.local" \\\line
  --data-urlencode "url=http://infra.example/b" \\\line
  --data-urlencode "ip=10.0.0.30"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=infra3@demo.local" \\\line
  --data-urlencode "url=http://infra.example/c" \\\line
  --data-urlencode "ip=10.0.0.30"\par}
{\pard \ql \f0 \sa180 \li0 \fi0 K\u7923 ? v\u7885 ?ng:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab IP {\f1 10.0.0.30} \u273 ?\u432 ?\u7907 ?c nhi\u7873 ?u Email {\f1 SENT_FROM}.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?\u7889 ?i chi\u7871 ?u nhanh b\u7857 ?ng Cypher:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (i:IPAddress \{value:"10.0.0.30"\})<-[:SENT_FROM]-(e:Email)\line
RETURN i.value, collect(e.value) AS emails, count(DISTINCT e) AS n;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 7.4.4 K\u7883 ?ch b\u7843 ?n 4: Nh\u7853 ?p d\u7919 ? li\u7879 ?u thi\u7871 ?u triad (\u273 ?\u7875 ? th\u7845 ?y UNKNOWN)\par}
