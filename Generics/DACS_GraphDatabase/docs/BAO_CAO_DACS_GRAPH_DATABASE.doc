{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b Kh\u7843 ? n\u259 ?ng m\u7903 ? r\u7897 ?ng}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u243 ? th\u7875 ? m\u7903 ? r\u7897 ?ng th\u234 ?m node/relationship (Domain, ASN, Recipient, Device\u8230 ?) m\u224 ? kh\u244 ?ng c\u7847 ?n thi\u7871 ?t k\u7871 ? l\u7841 ?i to\u224 ?n b\u7897 ? schema nh\u432 ? RDBMS.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 4)\tx360\tab {\b Kh\u237 ?a c\u7841 ?nh an to\u224 ?n/c\u7845 ?u h\u236 ?nh}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Th\u244 ?ng tin k\u7871 ?t n\u7889 ?i Neo4j \u273 ?\u432 ?\u7907 ?c c\u7845 ?u h\u236 ?nh qua bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng, gi\u7843 ?m nguy c\u417 ? l\u7897 ? m\u7853 ?t kh\u7849 ?u.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab API ingest s\u7917 ? d\u7909 ?ng {\f1 MERGE} \u273 ?\u7875 ? gi\u7843 ?m tr\u249 ?ng d\u7919 ? li\u7879 ?u v\u224 ? tr\u225 ?nh \u8220"b\u249 ?ng n\u7893 ?\u8221" node do nh\u7853 ?p l\u7863 ?p.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 6.5 Ph\u432 ?\u417 ?ng ph\u225 ?p \u273 ?\u225 ?nh gi\u225 ? th\u7921 ?c nghi\u7879 ?m (\u273 ?\u7873 ? xu\u7845 ?t tr\u236 ?nh b\u224 ?y trong b\u225 ?o c\u225 ?o)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u236 ? \u273 ?\u7891 ? \u225 ?n mang t\u237 ?nh minh h\u7885 ?a, ph\u7847 ?n \u273 ?\u225 ?nh gi\u225 ? t\u7853 ?p trung v\u224 ?o:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b \u272 ?\u7897 ? \u273 ?\u250 ?ng m\u244 ? h\u236 ?nh v\u224 ? truy v\u7845 ?n}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ki\u7875 ?m tra triad v\u224 ? shared pattern c\u243 ? xu\u7845 ?t hi\u7879 ?n \u273 ?\u250 ?ng theo d\u7919 ? li\u7879 ?u ingest.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b \u272 ?\u7897 ? \u8220"gi\u7843 ?i th\u237 ?ch \u273 ?\u432 ?\u7907 ?c\u8221" (explainability)}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab V\u7899 ?i m\u7895 ?i verdict \u273 ?\u225 ?ng nghi, c\u243 ? th\u7875 ? gi\u7843 ?i th\u237 ?ch b\u7857 ?ng li\u234 ?n k\u7871 ?t n\u224 ?o d\u7851 ?n \u273 ?\u7871 ?n \u273 ?i\u7875 ?m s\u7889 ?.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b \u272 ?\u7897 ? \u7893 ?n \u273 ?\u7883 ?nh khi t\u259 ?ng d\u7919 ? li\u7879 ?u (mang t\u237 ?nh quan s\u225 ?t)}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u259 ?ng s\u7889 ? Email tr\u7887 ? c\u249 ?ng URL/IP v\u224 ? quan s\u225 ?t thay \u273 ?\u7893 ?i score/verdict.\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 B\u7843 ?ng 6.1 (\u273 ?i\u7873 ?n trong Word): s\u7889 ? l\u432 ?\u7907 ?ng node/relationship theo t\u7915 ?ng l\u7847 ?n ingest v\u224 ? th\u7901 ?i gian ph\u7843 ?n h\u7891 ?i (ms) c\u7911 ?a {\f1 /api/graph/full} v\u224 ? {\f1 /api/graph/analyze}.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 6.6 Ch\u7845 ?t l\u432 ?\u7907 ?ng d\u7919 ? li\u7879 ?u v\u224 ? r\u7911 ?i ro hi\u7875 ?u sai\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong th\u7921 ?c t\u7871 ?, d\u7919 ? li\u7879 ?u phishing c\u243 ? th\u7875 ? nhi\u7877 ?u:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab URL r\u250 ?t g\u7885 ?n (shortener), redirect chain.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab IP thay \u273 ?\u7893 ?i do CDN ho\u7863 ?c NAT.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email gi\u7843 ? m\u7841 ?o header.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong demo, nh\u243 ?m ch\u7911 ? \u273 ?\u7897 ?ng \u8220"\u273 ?\u417 ?n gi\u7843 ?n h\u243 ?a\u8221" d\u7919 ? li\u7879 ?u \u273 ?\u7875 ? nh\u7845 ?n m\u7841 ?nh c\u7845 ?u tr\u250 ?c quan h\u7879 ?. Khi tr\u236 ?nh b\u224 ?y, c\u7847 ?n n\u234 ?u r\u245 ? \u273 ?\u226 ?y l\u224 ? gi\u7899 ?i h\u7841 ?n c\u243 ? ch\u7911 ? \u273 ?\u237 ?ch.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 6.7 G\u243 ?c nh\u236 ?n an to\u224 ?n (li\u234 ?n h\u7879 ? m\u244 ?n h\u7885 ?c DACS)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7863 ?c d\u249 ? h\u7879 ? th\u7889 ?ng l\u224 ? demo, v\u7851 ?n c\u243 ? c\u225 ?c \u273 ?i\u7875 ?m c\u7847 ?n ch\u250 ? \u253 ? v\u7873 ? an to\u224 ?n d\u7919 ? li\u7879 ?u v\u224 ? c\u7845 ?u h\u236 ?nh:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b Qu\u7843 ?n l\u253 ? b\u237 ? m\u7853 ?t (secrets)}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Kh\u244 ?ng hard-code m\u7853 ?t kh\u7849 ?u DB.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u249 ?ng bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng v\u224 ? tr\u225 ?nh ghi log l\u7897 ? credentials.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b Validation input}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email/URL/IP n\u234 ?n \u273 ?\u432 ?\u7907 ?c validate \u7903 ? m\u7913 ?c c\u417 ? b\u7843 ?n \u273 ?\u7875 ? tr\u225 ?nh d\u7919 ? li\u7879 ?u \u8220"b\u7849 ?n\u8221" v\u224 ? gi\u7843 ?m nguy c\u417 ? injection.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Trong \u273 ?\u7891 ? \u225 ?n, ingest d\u249 ?ng query parameter v\u224 ? bind parameter trong {\f1 Neo4jClient} gi\u250 ?p gi\u7843 ?m r\u7911 ?i ro Cypher injection.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b Nguy\u234 ?n t\u7855 ?c k\u7871 ?t lu\u7853 ?n th\u7853 ?n tr\u7885 ?ng}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Triad-gating l\u224 ? m\u7897 ?t c\u417 ? ch\u7871 ? gi\u7843 ?m r\u7911 ?i ro \u8220"k\u7871 ?t lu\u7853 ?n sai\u8221" khi thi\u7871 ?u ng\u7919 ? c\u7843 ?nh.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Trong b\u225 ?o c\u225 ?o c\u7847 ?n nh\u7845 ?n m\u7841 ?nh: UNKNOWN kh\u244 ?ng \u273 ?\u7891 ?ng ngh\u297 ?a an to\u224 ?n, m\u224 ? l\u224 ? ch\u432 ?a \u273 ?\u7911 ? b\u7857 ?ng ch\u7913 ?ng.\sa180\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 CH\u431 ?\u416 ?NG 7: TH\u7920 ?C NGHI\u7878 ?M H\u7878 ? TH\u7888 ?NG\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.1 M\u7909 ?c ti\u234 ?u v\u224 ? ph\u7841 ?m vi th\u7921 ?c nghi\u7879 ?m\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong \u273 ?\u7891 ? \u225 ?n n\u224 ?y, \u8220"th\u7921 ?c nghi\u7879 ?m h\u7879 ? th\u7889 ?ng\u8221" \u273 ?\u432 ?\u7907 ?c hi\u7875 ?u theo ngh\u297 ?a {\b th\u7921 ?c nghi\u7879 ?m demo/ki\u7875 ?m ch\u7913 ?ng} (proof-of-concept), t\u7853 ?p trung x\u225 ?c nh\u7853 ?n:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b T\u237 ?nh \u273 ?\u250 ?ng (correctness) c\u7911 ?a m\u244 ? h\u236 ?nh \u273 ?\u7891 ? th\u7883 ?}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Node/relationship \u273 ?\u432 ?\u7907 ?c t\u7841 ?o \u273 ?\u250 ?ng theo d\u7919 ? li\u7879 ?u nh\u7853 ?p.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u225 ?c pattern ch\u237 ?nh (triad, shared URL, shared IP) xu\u7845 ?t hi\u7879 ?n \u273 ?\u250 ?ng trong Neo4j.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b T\u237 ?nh \u273 ?\u250 ?ng c\u7911 ?a c\u417 ? ch\u7871 ? k\u7871 ?t lu\u7853 ?n (triad-gating + rule-based scoring)}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab N\u7871 ?u thi\u7871 ?u tam gi\u225 ?c Email\u8211-URL\u8211-IP th\u236 ? k\u7871 ?t qu\u7843 ? t\u7893 ?ng quan ph\u7843 ?i l\u224 ? {\f1 verdict=UNKNOWN} v\u224 ? {\f1 score=0}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab N\u7871 ?u \u273 ?\u7911 ? triad, \u273 ?i\u7875 ?m s\u7889 ? ph\u7843 ?n \u225 ?nh c\u225 ?c indicator \u273 ?\u227 ? thi\u7871 ?t k\u7871 ?.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab {\b Kh\u7843 ? n\u259 ?ng gi\u7843 ?i th\u237 ?ch (explainability) v\u224 ? tr\u236 ?nh b\u224 ?y}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u243 ? th\u7875 ? gi\u7843 ?i th\u237 ?ch v\u236 ? sao m\u7897 ?t Email/URL/IP b\u7883 ? \u273 ?\u225 ?nh d\u7845 ?u \u273 ?\u225 ?ng nghi d\u7921 ?a v\u224 ?o \u8220"d\u249 ?ng chung h\u7841 ? t\u7847 ?ng\u8221" v\u224 ? c\u7845 ?u tr\u250 ?c li\u234 ?n k\u7871 ?t.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ph\u7841 ?m vi v\u224 ? gi\u7843 ? \u273 ?\u7883 ?nh:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D\u7919 ? li\u7879 ?u demo do nh\u243 ?m t\u7921 ? t\u7841 ?o, mang t\u237 ?nh minh h\u7885 ?a (kh\u244 ?ng \u273 ?\u7841 ?i di\u7879 ?n t\u7853 ?p d\u7919 ? li\u7879 ?u th\u7921 ?c t\u7871 ?).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab M\u7909 ?c ti\u234 ?u kh\u244 ?ng ph\u7843 ?i benchmark hi\u7879 ?u n\u259 ?ng tuy\u7879 ?t \u273 ?\u7889 ?i, m\u224 ? l\u224 ? quan s\u225 ?t ph\u7843 ?n h\u7891 ?i API v\u224 ? \u273 ?\u7897 ? \u7893 ?n \u273 ?\u7883 ?nh khi t\u259 ?ng d\u7919 ? li\u7879 ?u.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.2 Th\u432 ?\u7899 ?c \u273 ?o/ti\u234 ?u ch\u237 ? ghi nh\u7853 ?n (g\u7907 ?i \u253 ? tr\u236 ?nh b\u224 ?y trong Word)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Nh\u243 ?m c\u243 ? th\u7875 ? ghi nh\u7853 ?n c\u225 ?c ti\u234 ?u ch\u237 ? sau (\u273 ?\u7883 ?nh t\u237 ?nh + \u273 ?\u7883 ?nh l\u432 ?\u7907 ?ng):\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b S\u7889 ? l\u432 ?\u7907 ?ng node/relationship} sau m\u7895 ?i l\u7847 ?n ingest (\u273 ?\u7889 ?i chi\u7871 ?u {\f1 /api/graph/full} v\u224 ? Neo4j Browser).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Th\u7901 ?i gian ph\u7843 ?n h\u7891 ?i} (ms) c\u7911 ?a c\u225 ?c API ch\u237 ?nh ({\f1 /api/graph/full}, {\f1 /api/graph/analyze}).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b T\u7927 ? l\u7879 ? UNKNOWN} trong t\u7853 ?p Email demo (\u273 ?\u7875 ? minh h\u7885 ?a triad-gating).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\b Minh ch\u7913 ?ng tr\u7921 ?c quan}: screenshot UI tr\u432 ?\u7899 ?c/sau analyze; screenshot Neo4j Browser truy v\u7845 ?n triad/shared.\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 G\u7907 ?i \u253 ?: \u273 ?o th\u7901 ?i gian ph\u7843 ?n h\u7891 ?i b\u7857 ?ng {\f1 curl -w "%\{time_total\}"} ho\u7863 ?c d\u249 ?ng DevTools Network khi m\u7903 ? UI.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.3 Chu\u7849 ?n b\u7883 ? m\u244 ?i tr\u432 ?\u7901 ?ng\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab C\u7845 ?u h\u236 ?nh bi\u7871 ?n m\u244 ?i tr\u432 ?\u7901 ?ng Neo4j (tham kh\u7843 ?o Ch\u432 ?\u417 ?ng 5).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab Ch\u7841 ?y \u7913 ?ng d\u7909 ?ng Spring Boot.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 3)\tx360\tab X\u225 ?c nh\u7853 ?n h\u7879 ? th\u7889 ?ng k\u7871 ?t n\u7889 ?i Neo4j:\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 curl http://localhost:8080/api/graph/health\par}
{\pard \ql \f0 \sa180 \li0 \fi0 K\u7923 ? v\u7885 ?ng:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab HTTP 200\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab JSON c\u243 ? tr\u432 ?\u7901 ?ng {\f1 status} th\u7875 ? hi\u7879 ?n k\u7871 ?t n\u7889 ?i Neo4j th\u224 ?nh c\u244 ?ng.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.4 T\u7841 ?o d\u7919 ? li\u7879 ?u demo\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7909 ?c ti\u234 ?u c\u7911 ?a b\u432 ?\u7899 ?c n\u224 ?y l\u224 ? t\u7841 ?o c\u225 ?c c\u7845 ?u tr\u250 ?c \u273 ?\u7863 ?c tr\u432 ?ng:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab 01 triad t\u7889 ?i thi\u7875 ?u (Email\u8211-URL\u8211-IP)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab 01 chi\u7871 ?n d\u7883 ?ch shared URL (nhi\u7873 ?u Email \u8594 ? 01 URL)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab 01 h\u7841 ? t\u7847 ?ng shared IP (nhi\u7873 ?u Email \u8594 ? 01 IP)\par}
