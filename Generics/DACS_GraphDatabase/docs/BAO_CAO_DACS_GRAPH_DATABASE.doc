  --data-urlencode "url=http://campaign.example/login" \\\line
  --data-urlencode "ip=10.0.0.21"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=camp2@demo.local" \\\line
  --data-urlencode "url=http://campaign.example/login" \\\line
  --data-urlencode "ip=10.0.0.22"\line
curl -G "$API/link" \\\line
  --data-urlencode "email=camp3@demo.local" \\\line
  --data-urlencode "url=http://campaign.example/login" \\\line
  --data-urlencode "ip=10.0.0.23"\par}
