\intbl\row}
{\pard \ql \f0 \sa180 \li0 \fi0 \par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Ghi ch\u250 ? v\u7873 ? \u253 ? ngh\u297 ?a {\f1 riskScore} trong h\u7879 ? th\u7889 ?ng}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab {\f1 riskScore} {\b l\u432 ?u tr\u234 ?n node} (node property) \u273 ?\u432 ?\u7907 ?c c\u7853 ?p nh\u7853 ?t b\u7903 ?i {\f1 GET /api/graph/analyze} theo lu\u7853 ?t ch\u7845 ?m \u273 ?i\u7875 ?m v\u224 ? {\b thang 0\u8211-100} (c\u243 ? triad-gating).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Nh\u243 ?m API {\f1 GET /api/graph/analysis/*} tr\u7843 ? v\u7873 ? m\u7897 ?t tr\u432 ?\u7901 ?ng {\f1 riskScore} kh\u225 ?c: \u273 ?\u226 ?y l\u224 ? {\b \u273 ?i\u7875 ?m th\u7889 ?ng k\u234 ?} (v\u237 ? d\u7909 ? t\u7893 ?ng s\u7889 ? li\u234 ?n k\u7871 ?t ho\u7863 ?c s\u7889 ? th\u7921 ?c th\u7875 ? li\u234 ?n quan) d\u249 ?ng \u273 ?\u7875 ? ph\u226 ?n lo\u7841 ?i {\f1 riskLevel} v\u224 ? sinh {\f1 indicators}. Tr\u432 ?\u7901 ?ng n\u224 ?y {\b kh\u244 ?ng thay th\u7871 ?} {\f1 riskScore} \u273 ?\u227 ? l\u432 ?u tr\u234 ?n node.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 4.3 Thi\u7871 ?t k\u7871 ? thu\u7853 ?t to\u225 ?n ph\u226 ?n t\u237 ?ch r\u7911 ?i ro (rule-based)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.3.1 Nguy\u234 ?n t\u7855 ?c ch\u7845 ?m \u273 ?i\u7875 ?m\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?i\u7875 ?m r\u7911 ?i ro \u273 ?\u432 ?\u7907 ?c suy ra t\u7915 ? quan h\u7879 ?:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u243 ? URL trong email\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u243 ? IP ngu\u7891 ?n\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Shared URL / Shared IP (d\u249 ?ng chung)\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Triad-gating (ng\u7919 ? c\u7843 ?nh t\u7889 ?i thi\u7875 ?u)}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Ch\u7881 ? t\u237 ?nh \u273 ?i\u7875 ?m khi Email tham gia \u273 ?\u7911 ? triad.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong code, triad c\u7911 ?a Email \u273 ?\u432 ?\u7907 ?c ki\u7875 ?m tra b\u7857 ?ng \u273 ?i\u7873 ?u ki\u7879 ?n t\u7891 ?n t\u7841 ?i \u273 ?\u7891 ?ng th\u7901 ?i:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email c\u243 ? {\f1 CONTAINS_LINK} t\u7899 ?i m\u7897 ?t URL.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Email c\u243 ? {\f1 SENT_FROM} t\u7899 ?i m\u7897 ?t IP.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab URL \u273 ?\u243 ? {\f1 HOSTED_BY} \u273 ?\u250 ?ng IP m\u224 ? Email g\u7917 ?i t\u7915 ?.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.3.2 Ph\u225 ?t hi\u7879 ?n shared IP\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7897 ?t IP \u273 ?\u225 ?ng nghi khi nhi\u7873 ?u Email c\u249 ?ng {\f1 SENT_FROM} v\u7873 ? IP \u273 ?\u243 ?.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.3.3 Ph\u225 ?t hi\u7879 ?n shared URL\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7897 ?t URL \u273 ?\u225 ?ng nghi khi nhi\u7873 ?u Email c\u249 ?ng {\f1 CONTAINS_LINK} t\u7899 ?i URL \u273 ?\u243 ?.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.3.4 Ph\u226 ?n lo\u7841 ?i verdict (kh\u7899 ?p code)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab N\u7871 ?u ch\u432 ?a \u273 ?\u7911 ? triad: {\f1 verdict = UNKNOWN}, {\f1 score = 0}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab N\u7871 ?u \u273 ?\u7911 ? triad:\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab {\f1 score >= 60} \u8594 ? {\f1 FRAUD}\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab {\f1 0 < score < 60} \u8594 ? {\f1 SUSPICIOUS}\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab {\f1 score = 0} \u8594 ? {\f1 SAFE}\sa180\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.3.6 B\u7843 ?ng ch\u7845 ?m \u273 ?i\u7875 ?m v\u224 ? gi\u7843 ? m\u227 ? (pseudocode)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b A) Th\u224 ?nh ph\u7847 ?n \u273 ?i\u7875 ?m cho Email (\u273 ?\u250 ?ng theo tri\u7875 ?n khai)}\par}
{
\trowd \trgaph120
