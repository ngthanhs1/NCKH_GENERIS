\cellx4320\cellx8640
\trkeep\intbl
{
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 C\u243 ? IP trong danh s\u225 ?ch IP c\u7911 ?a Email m\u224 ? IP \u273 ?\u243 ? \u273 ?\u432 ?\u7907 ?c >1 Email d\u249 ?ng ({\f1 shared IP})\par}
\cell}
{{\pard\intbl \qr \f0 \sa0 \li0 \fi0 +30\par}
\cell}
}
\intbl\row}
{
\trowd \trgaph120
\cellx4320\cellx8640
\trkeep\intbl
{
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 C\u243 ? URL trong danh s\u225 ?ch URL c\u7911 ?a Email m\u224 ? URL \u273 ?\u243 ? xu\u7845 ?t hi\u7879 ?n trong >1 Email ({\f1 shared URL})\par}
\cell}
{{\pard\intbl \qr \f0 \sa0 \li0 \fi0 +30\par}
\cell}
}
\intbl\row}
{\pard \ql \f0 \sa180 \li0 \fi0 \par}
{\pard \ql \f0 \sa180 \li0 \fi0 Chu\u7849 ?n h\u243 ?a: n\u7871 ?u t\u7893 ?ng \u273 ?i\u7875 ?m > 100 th\u236 ? c\u7855 ?t v\u7873 ? 100.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b B) Pseudocode t\u7893 ?ng quan}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 for each Email e:\line
  urls = URLs linked by (e)-[:CONTAINS_LINK]->(u)\line
  ips  = IPs linked by (e)-[:SENT_FROM]->(i)\line
  hasTriad = exists (u in urls, i in ips) such that (u)-[:HOSTED_BY]->(i)\line
\line
  if not hasTriad:\line
    score = 0\line
    verdict = UNKNOWN\line
  else:\line
    score = 0\line
    if urls not empty: score += 30\line
    if ips not empty:  score += 20\line
    if exists ip in ips with countEmailsSentFrom(ip) > 1: score += 30\line
    if exists url in urls with countEmailsContaining(url) > 1: score += 30\line
    score = min(score, 100)\line
\line
    if score >= 60: verdict = FRAUD\line
    else if score > 0: verdict = SUSPICIOUS\line
    else verdict = SAFE\line
\line
  persist e.riskScore = score and e.verdict = verdict\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Ghi ch\u250 ?: URL v\u224 ? IP trong {\f1 /api/graph/analyze} \u273 ?ang d\u249 ?ng rule t\u7889 ?i gi\u7843 ?n (shared \u8594 ? 30) \u273 ?\u7875 ? ph\u7909 ?c v\u7909 ? t\u244 ? m\u224 ?u tr\u7921 ?c quan; chi ti\u7871 ?t th\u7889 ?ng k\u234 ? n\u7857 ?m \u7903 ? nh\u243 ?m {\f1 /api/graph/analysis/*}.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.3.5 Hai nh\u243 ?m API ph\u226 ?n t\u237 ?ch (\u273 ?\u7875 ? tr\u225 ?nh hi\u7875 ?u nh\u7847 ?m)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 H\u7879 ? th\u7889 ?ng c\u243 ? hai nh\u243 ?m API ph\u226 ?n t\u237 ?ch v\u7899 ?i m\u7909 ?c \u273 ?\u237 ?ch kh\u225 ?c nhau:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b Ph\u226 ?n t\u237 ?ch t\u7893 ?ng quan (ph\u7909 ?c v\u7909 ? t\u244 ? m\u224 ?u UI)}: {\f1 GET /api/graph/analyze}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab G\u225 ?n {\f1 riskScore} (0\u8211-100) v\u224 ? {\f1 verdict} (SAFE/SUSPICIOUS/FRAUD/UNKNOWN) l\u234 ?n node trong Neo4j.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u193 ?p d\u7909 ?ng triad-gating: ch\u432 ?a \u273 ?\u7911 ? triad \u8594 ? UNKNOWN.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b Ph\u226 ?n t\u237 ?ch chi ti\u7871 ?t (ph\u7909 ?c v\u7909 ? th\u7889 ?ng k\u234 ?/di\u7877 ?n gi\u7843 ?i)}: {\f1 GET /api/graph/analysis/email-risk|url-risk|ip-risk}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Tr\u7843 ? v\u7873 ? {\f1 riskScore}, {\f1 riskLevel}, {\f1 indicators} (nh\u227 ?n ti\u7871 ?ng Vi\u7879 ?t) d\u7921 ?a tr\u234 ?n s\u7889 ? l\u432 ?\u7907 ?ng li\u234 ?n k\u7871 ?t.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Nh\u243 ?m n\u224 ?y ch\u7911 ? y\u7871 ?u ph\u7909 ?c v\u7909 ? b\u225 ?o c\u225 ?o v\u224 ? quan s\u225 ?t nhanh, kh\u244 ?ng nh\u7857 ?m thay th\u7871 ? quy \u432 ?\u7899 ?c verdict c\u7911 ?a {\f1 /api/graph/analyze}.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 4.4 Thi\u7871 ?t k\u7871 ? giao di\u7879 ?n tr\u7921 ?c quan\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.4.1 Force-directed layout\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab D3 force simulation gi\u250 ?p node t\u7921 ? ph\u226 ?n b\u7889 ?.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.4.2 T\u244 ? m\u224 ?u theo m\u7913 ?c \u273 ?\u7897 ? r\u7911 ?i ro\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab SAFE: xanh\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab SUSPICIOUS: cam\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab FRAUD: \u273 ?\u7887 ?\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab UNKNOWN: x\u225 ?m\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.4.3 B\u7897 ? l\u7885 ?c d\u7919 ? li\u7879 ?u\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Filter theo type (Email/URL/IP)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Filter theo verdict (SAFE/SUSPICIOUS/FRAUD/UNKNOWN)\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 4.4.4 Trang report\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab T\u7893 ?ng h\u7907 ?p s\u7889 ? node theo verdict\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab B\u7843 ?ng top node \u273 ?\u225 ?ng nghi\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Xu\u7845 ?t CSV / in b\u225 ?o c\u225 ?o\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 4.5 Thi\u7871 ?t k\u7871 ? API v\u224 ? d\u7919 ? li\u7879 ?u trao \u273 ?\u7893 ?i\par}
