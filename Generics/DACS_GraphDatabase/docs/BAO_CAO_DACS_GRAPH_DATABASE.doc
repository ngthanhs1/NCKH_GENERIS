{\pard \ql \f0 \sa180 \li0 \fi0 S\u7917 ? d\u7909 ?ng Spring Data Neo4j repository cho CRUD c\u417 ? b\u7843 ?n.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 5.1.3 Service Layer\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Service trung t\u226 ?m: {\f1 GraphQueryService}\par}
