{\pard \ql \f0 \sa180 \li720 \fi0 {\b H\u236 ?nh 7.4 (minh h\u7885 ?a)}: Minh h\u7885 ?a c\u7909 ?m shared URL/shared IP sau analyze (ph\u7909 ?c v\u7909 ? ch\u232 ?n h\u236 ?nh v\u224 ?o Word). N\u7871 ?u nh\u243 ?m c\u243 ? screenshot UI th\u7853 ?t, c\u243 ? th\u7875 ? thay \u7843 ?nh minh h\u7885 ?a n\u224 ?y b\u7857 ?ng screenshot.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\pict\pngblip\picw1200\pich520\picwgoal24000\pichgoal10400 }\par}
{\pard \ql \f0 \sa180 \li0 \fi0 N\u7871 ?u c\u7847 ?n \u273 ?\u7889 ?i chi\u7871 ?u d\u7919 ? li\u7879 ?u th\u244 ? m\u224 ? UI \u273 ?ang d\u249 ?ng:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 curl http://localhost:8080/api/graph/full\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 7.6.2 Demo giao di\u7879 ?n (UI walkthrough \u8211- 2 \u273 ?\u7871 ?n 3 ph\u250 ?t)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 M\u7909 ?c ti\u234 ?u c\u7911 ?a ph\u7847 ?n n\u224 ?y l\u224 ? tr\u236 ?nh b\u224 ?y r\u245 ? {\b ng\u432 ?\u7901 ?i d\u249 ?ng thao t\u225 ?c g\u236 ? tr\u234 ?n giao di\u7879 ?n} v\u224 ? {\b v\u236 ? sao giao di\u7879 ?n ch\u7913 ?ng minh \u273 ?\u432 ?\u7907 ?c gi\u225 ? tr\u7883 ? c\u7911 ?a Graph DB}.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b B\u432 ?\u7899 ?c 1: M\u7903 ? giao di\u7879 ?n \u273 ?\u7891 ? th\u7883 ?}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab M\u7903 ? trang ch\u237 ?nh: {\f1 http://localhost:8080/}.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab K\u7923 ? v\u7885 ?ng: th\u7845 ?y c\u225 ?c node/edge theo d\u7919 ? li\u7879 ?u \u273 ?\u227 ? ingest.\sa180\par}
{\pard \ql \f0 \sa180 \li720 \fi0 G\u7907 ?i \u253 ? ch\u7909 ?p \u7843 ?nh: t\u7893 ?ng quan \u273 ?\u7891 ? th\u7883 ? tr\u432 ?\u7899 ?c analyze (H\u236 ?nh 7.1).\par}
