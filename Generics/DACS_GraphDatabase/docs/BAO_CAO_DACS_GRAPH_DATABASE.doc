{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab L\u7885 ?c UI theo verdict/type hi\u7875 ?n th\u7883 ? \u273 ?\u250 ?ng.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 N\u7871 ?u c\u7847 ?n ki\u7875 ?m th\u7917 ? nhanh b\u7857 ?ng l\u7879 ?nh:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64\line
export PATH="$JAVA_HOME/bin:$PATH"\line
\line
./gradlew test\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 CH\u431 ?\u416 ?NG 6: PH\u194 ?N T\u205 ?CH V\u192 ? \u272 ?\u193 ?NH GI\u193 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 6.1 So s\u225 ?nh hi\u7879 ?u n\u259 ?ng JOIN v\u224 ? Graph Traversal (l\u253 ? thuy\u7871 ?t)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 6.1.1 Truy v\u7845 ?n b\u7857 ?ng JOIN (RDBMS)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u7899 ?i m\u244 ? h\u236 ?nh quan h\u7879 ?, truy v\u7871 ?t Email\u8594 ?URL\u8594 ?IP th\u432 ?\u7901 ?ng c\u7847 ?n nhi\u7873 ?u JOIN (email, url, ip + b\u7843 ?ng trung gian).\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u237 ? d\u7909 ? (minh h\u7885 ?a) v\u7899 ?i m\u244 ? h\u236 ?nh quan h\u7879 ? c\u243 ? b\u7843 ?ng li\u234 ?n k\u7871 ?t:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 SELECT e.value, u.value, ip.value\line
FROM email e\line
JOIN email_url eu ON eu.email_id = e.id\line
JOIN url u ON u.id = eu.url_id\line
JOIN url_ip ui ON ui.url_id = u.id\line
JOIN ipaddress ip ON ip.id = ui.ip_id;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Nh\u7853 ?n x\u233 ?t:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab S\u7889 ? ph\u233 ?p JOIN t\u259 ?ng theo s\u7889 ? b\u432 ?\u7899 ?c li\u234 ?n k\u7871 ?t.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab K\u7871 ? ho\u7841 ?ch truy v\u7845 ?n ph\u7909 ? thu\u7897 ?c v\u224 ?o index v\u224 ? join order.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab C\u243 ? th\u7875 ? sinh d\u7919 ? li\u7879 ?u trung gian l\u7899 ?n.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 6.1.2 Truy v\u7845 ?n b\u7857 ?ng Traversal (Graph)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Trong graph, truy v\u7845 ?n \u273 ?\u432 ?\u7907 ?c bi\u7875 ?u di\u7877 ?n tr\u7921 ?c ti\u7871 ?p b\u7857 ?ng pattern v\u224 ? traversal theo c\u7841 ?nh.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 V\u237 ? d\u7909 ? Cypher t\u432 ?\u417 ?ng \u273 ?\u432 ?\u417 ?ng:\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 MATCH (e:Email)-[:CONTAINS_LINK]->(u:URL)-[:HOSTED_BY]->(i:IPAddress)\line
RETURN e.value, u.value, i.value;\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Nh\u7853 ?n x\u233 ?t:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Pattern th\u7875 ? hi\u7879 ?n tr\u7921 ?c quan c\u7845 ?u tr\u250 ?c c\u7847 ?n t\u236 ?m.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Khi truy v\u7845 ?n t\u7853 ?p trung v\u224 ?o m\u7897 ?t ph\u7847 ?n \u273 ?\u7891 ? th\u7883 ?, traversal th\u432 ?\u7901 ?ng ch\u7881 ? duy\u7879 ?t c\u225 ?c node/c\u7841 ?nh li\u234 ?n quan.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 6.1.3 Nh\u7853 ?n x\u233 ?t\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab JOIN th\u432 ?\u7901 ?ng sinh d\u7919 ? li\u7879 ?u trung gian v\u224 ? ph\u7909 ? thu\u7897 ?c join order.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Traversal t\u7853 ?p trung v\u224 ?o ph\u7847 ?n \u273 ?\u7891 ? th\u7883 ? \u273 ?\u432 ?\u7907 ?c duy\u7879 ?t.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 T\u7915 ? g\u243 ?c nh\u236 ?n \u273 ?\u7897 ? ph\u7913 ?c t\u7841 ?p (mang t\u237 ?nh l\u253 ? thuy\u7871 ?t):\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab JOIN ph\u7909 ? thu\u7897 ?c v\u224 ?o k\u237 ?ch th\u432 ?\u7899 ?c b\u7843 ?ng v\u224 ? t\u237 ?nh ch\u7885 ?n l\u7885 ?c; khi nhi\u7873 ?u JOIN, chi ph\u237 ? c\u243 ? th\u7875 ? t\u259 ?ng m\u7841 ?nh do intermediate results.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Traversal th\u432 ?\u7901 ?ng x\u7845 ?p x\u7881 ? theo s\u7889 ? node/c\u7841 ?nh th\u7921 ?c s\u7921 ? \u273 ?\u432 ?\u7907 ?c duy\u7879 ?t: {\i O}({\i V}{\sub {\i v}{\i i}{\i s}{\i i}{\i t}{\i e}{\i d}}+{\i E}{\sub {\i v}{\i i}{\i s}{\i i}{\i t}{\i e}{\i d}}).\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 6.2 Minh h\u7885 ?a Pattern Detection trong \u273 ?\u7891 ? th\u7883 ?\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 6.2.1 Shared URL pattern\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Nhi\u7873 ?u Email \u8594 ? c\u249 ?ng URL \u8594 ? g\u7907 ?i \u253 ? campaign.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 6.2.2 Shared IP pattern\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Nhi\u7873 ?u Email \u8594 ? c\u249 ?ng IP \u8594 ? g\u7907 ?i \u253 ? h\u7841 ? t\u7847 ?ng spam.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 6.2.3 Hub IP pattern\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Nhi\u7873 ?u URL host tr\u234 ?n c\u249 ?ng IP \u8594 ? g\u7907 ?i \u253 ? hosting hub.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel3 \b \fs24 6.2.4 \u221 ? ngh\u297 ?a ph\u226 ?n t\u237 ?ch\par}
{\pard \ql \f0 \sa180 \li0 \fi0 C\u225 ?c pattern gi\u250 ?p gi\u7843 ?i th\u237 ?ch \u8220"v\u236 ? sao \u273 ?\u225 ?ng nghi\u8221" d\u7921 ?a tr\u234 ?n c\u7845 ?u tr\u250 ?c quan h\u7879 ?.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 S\u417 ? \u273 ?\u7891 ? lu\u7891 ?ng ph\u225 ?t hi\u7879 ?n pattern (minh h\u7885 ?a \u273 ?\u250 ?ng tinh th\u7847 ?n \u273 ?\u7891 ? \u225 ?n):\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 flowchart TD\line
  A["Ingest d\u7919 ? li\u7879 ?u: Email, URL, IP"] --> B\{"\u272 ?\u227 ? h\u236 ?nh th\u224 ?nh \u273 ?\u7911 ? tam gi\u225 ?c? (Email-URL, Email-IP, URL-IP)"\}\line
  B -- "Ch\u432 ?a \u273 ?\u7911 ?" --> B1["Gi\u7919 ? UNKNOWN<br/>(thi\u7871 ?u ng\u7919 ? c\u7843 ?nh)"]\line
  B -- "\u272 ?\u7911 ?" --> C["Tr\u237 ?ch xu\u7845 ?t th\u7889 ?ng k\u234 ? l\u226 ?n c\u7853 ?n"]\line
\line
  C --> C1["sharedURL: s\u7889 ? Email tr\u7887 ? c\u249 ?ng URL"]\line
  C --> C2["sharedIP: s\u7889 ? Email g\u7917 ?i t\u7915 ? c\u249 ?ng IP"]\line
  C --> C3["hostedURLs: s\u7889 ? URL c\u249 ?ng host tr\u234 ?n IP"]\line
\line
  C1 --> D\{"Pattern n\u7893 ?i b\u7853 ?t?"\}\line
  C2 --> D\line
  C3 --> D\line
\line
  D -- "sharedURL \u8805 ? 2" --> P1["Phishing campaign"]\line
  D -- "sharedIP \u8805 ? 2" --> P2["Spam-Botnet infra"]\line
  D -- "hostedURLs \u8805 ? 2" --> P3["Hosting hub"]\line
  D -- "Kh\u244 ?ng" --> P0["Chu\u7895 ?i \u273 ?\u417 ?n l\u7867 ?"]\line
\line
  P1 --> E["Ch\u7845 ?m \u273 ?i\u7875 ?m/\u273 ?\u225 ?nh nh\u227 ?n (rule-based)"]\line
  P2 --> E\line
  P3 --> E\line
  P0 --> E\line
\line
  E --> F["Hi\u7875 ?n th\u7883 ?: m\u224 ?u node + l\u253 ? do"]\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \u272 ?i\u7875 ?m nh\u7845 ?n: \u273 ?\u7891 ? \u225 ?n \u432 ?u ti\u234 ?n \u8220"gi\u7843 ?i th\u237 ?ch \u273 ?\u432 ?\u7907 ?c\u8221" h\u417 ?n l\u224 ? t\u7889 ?i \u432 ?u m\u244 ? h\u236 ?nh ph\u226 ?n lo\u7841 ?i.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 6.3 \u431 ?u \u273 ?i\u7875 ?m v\u224 ? h\u7841 ?n ch\u7871 ?\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab \u431 ?u \u273 ?i\u7875 ?m: truy v\u7871 ?t/pattern tr\u7921 ?c quan, ph\u249 ? h\u7907 ?p demo.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab H\u7841 ?n ch\u7871 ?: rule-based \u273 ?\u417 ?n gi\u7843 ?n, d\u7919 ? li\u7879 ?u demo nh\u7887 ?; c\u7847 ?n th\u234 ?m d\u7919 ? li\u7879 ?u/feature \u273 ?\u7875 ? g\u7847 ?n th\u7921 ?c t\u7871 ?.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 6.4 \u272 ?\u225 ?nh gi\u225 ? theo c\u225 ?c ti\u234 ?u ch\u237 ? c\u7911 ?a \u273 ?\u7891 ? \u225 ?n\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 1)\tx360\tab {\b T\u237 ?nh ph\u249 ? h\u7907 ?p m\u244 ? h\u236 ?nh}\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab M\u244 ? h\u236 ?nh Email\u8211-URL\u8211-IP \u273 ?\u7911 ? nh\u7887 ? \u273 ?\u7875 ? demo nh\u432 ?ng v\u7851 ?n th\u7875 ? hi\u7879 ?n r\u245 ? gi\u225 ? tr\u7883 ? c\u7911 ?a quan h\u7879 ?.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 2)\tx360\tab {\b Kh\u7843 ? n\u259 ?ng gi\u7843 ?i th\u237 ?ch}\sa180\par}
